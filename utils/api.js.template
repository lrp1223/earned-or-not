// ============================================
// 赚了么 API 工具类（模板）
// 复制为 api.js，将 BASE_URL 替换为你的后端地址。
// 收到 401 时自动走 wx.login 重新登录并重试请求。
// ============================================

const BASE_URL = 'http://YOUR_SERVER_IP:8081';

/** Get token from storage */
function getToken() {
  return wx.getStorageSync('token') || '';
}

/** Save token to storage */
function saveToken(token) {
  wx.setStorageSync('token', token);
}

/**
 * 统一请求封装，自动带 Authorization Bearer token。
 * 收到 401 时自动触发重新登录并重试（最多重试一次）。
 */
function request(method, path, data, isRetry) {
  return new Promise((resolve, reject) => {
    wx.request({
      url: BASE_URL + path,
      method: method,
      header: {
        'Content-Type': 'application/json',
        'Authorization': 'Bearer ' + getToken()
      },
      data: data,
      success: (res) => {
        if (res.statusCode === 401) {
          if (isRetry) {
            wx.removeStorageSync('token');
            reject({ message: '登录已过期，请重启小程序', code: 401 });
            return;
          }
          doRelogin().then(() => {
            request(method, path, data, true).then(resolve, reject);
          }).catch(reject);
          return;
        }
        if (res.statusCode === 200 && res.data && res.data.success) {
          resolve(res.data);
        } else {
          reject(res.data || { message: '请求失败' });
        }
      },
      fail: reject
    });
  });
}

let reloginPromise = null;

function doRelogin() {
  if (reloginPromise) return reloginPromise;

  reloginPromise = new Promise((resolve, reject) => {
    wx.removeStorageSync('token');
    wx.login({
      success: (loginRes) => {
        if (loginRes.code) {
          wx.request({
            url: BASE_URL + '/api/user/login',
            method: 'POST',
            header: { 'Content-Type': 'application/json' },
            data: { code: loginRes.code },
            success: (res) => {
              if (res.statusCode === 200 && res.data && res.data.success) {
                saveToken(res.data.data.token);
                var app = getApp();
                app.globalData.userId = res.data.data.userId;
                app.globalData.token = res.data.data.token;
                reloginPromise = null;
                resolve();
              } else {
                reloginPromise = null;
                reject(res.data || { message: '自动登录失败' });
              }
            },
            fail: (err) => {
              reloginPromise = null;
              reject(err);
            }
          });
        } else {
          reloginPromise = null;
          reject({ message: 'wx.login 未返回 code' });
        }
      },
      fail: (err) => {
        reloginPromise = null;
        reject(err);
      }
    });
  });

  return reloginPromise;
}

module.exports = {
  login(code) { return request('POST', '/api/user/login', { code }); },
  getProfile() { return request('GET', '/api/user/profile'); },
  updateProfile(data) { return request('PUT', '/api/user/profile', data); },
  addRecord(data) { return request('POST', '/api/records', data); },
  updateRecord(id, data) { return request('PUT', '/api/records/' + id, data); },
  deleteRecord(id) { return request('DELETE', '/api/records/' + id); },
  getRecord(id) { return request('GET', '/api/records/' + id); },
  getLastWinAmount(lotteryType) { return request('GET', '/api/records/last-win?lotteryType=' + encodeURIComponent(lotteryType || '')); },
  getPersonalStats() { return request('GET', '/api/stats/personal'); },
  getRecentRecords(limit) { return request('GET', '/api/stats/recent?limit=' + (limit || 5)); },
  getTypeRecords(type, page, pageSize) { return request('GET', '/api/stats/records?type=' + type + '&page=' + (page || 1) + '&pageSize=' + (pageSize || 10)); },
  getRank(type, page, pageSize) { return request('GET', '/api/rank?type=' + (type || 'total') + '&page=' + (page || 1) + '&pageSize=' + (pageSize || 20)); },
  saveToken
};
