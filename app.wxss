/**app.wxss**/
page {
  /* 设计变量：全站颜色/圆角统一引用，改主题只动这里 */
  --primary: #ff6b6b;
  --primary-tint: #fdeeee;
  --win: #52c41a;
  --lose: #ff4d4f;
  --bg: #fafafa;
  --card-border: #efefef;
  --radius: 24rpx;
  --gap: 20rpx;

  font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
  background-color: var(--bg);
  color: #222;
}

.container { padding: 20rpx; }

.card {
  background: #fff;
  border: 1rpx solid var(--card-border);
  border-radius: var(--radius);
  padding: 30rpx;
  margin-bottom: var(--gap);
}

.btn-primary { background: var(--primary); color: white; border-radius: 44rpx; font-size: 32rpx; font-weight: bold; }
.btn-primary::after { border: none; }

.title { font-size: 34rpx; font-weight: bold; color: #222; margin-bottom: 20rpx; }
.amount-positive { font-weight: bold; }
.amount-negative { font-weight: bold; }
