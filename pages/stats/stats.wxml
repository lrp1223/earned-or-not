<!--pages/stats/stats.wxml-->
<view class="container">
  <!-- 总盈亏 -->
  <view class="card summary-card">
    <view class="summary-title">年度总盈亏</view>
    <view class="summary-amount" style="color: {{stats.totalNet >= 0 ? winColor : loseColor}}">
      {{stats.totalNet >= 0 ? '+' : ''}}{{stats.totalNet}} 元
    </view>
  </view>
  
  <!-- 彩 -->
  <view class="card" bindtap="goRecordList" data-type="lottery">
    <view class="stat-row">
      <text class="stat-title">🎰 彩</text>
      <text class="stat-net" style="color: {{stats.lottery.net >= 0 ? winColor : loseColor}}">
        {{stats.lottery.net >= 0 ? '+' : ''}}{{stats.lottery.net}} 元
      </text>
    </view>
    <text class="stat-arrow">查看全部 ›</text>
  </view>
  
  <!-- 刮 -->
  <view class="card" bindtap="goRecordList" data-type="scratch">
    <view class="stat-row">
      <text class="stat-title">🎫 刮</text>
      <text class="stat-net" style="color: {{stats.scratch.net >= 0 ? winColor : loseColor}}">
        {{stats.scratch.net >= 0 ? '+' : ''}}{{stats.scratch.net}} 元
      </text>
    </view>
    <text class="stat-arrow">查看全部 ›</text>
  </view>
  
  <!-- 麻将 -->
  <view class="card" bindtap="goRecordList" data-type="mahjong">
    <view class="stat-row">
      <text class="stat-title">🀄 麻将</text>
      <text class="stat-net" style="color: {{stats.mahjong.net >= 0 ? winColor : loseColor}}">
        {{stats.mahjong.net >= 0 ? '+' : ''}}{{stats.mahjong.net}} 元
      </text>
    </view>
    <text class="stat-arrow">查看全部 ›</text>
  </view>
</view>
