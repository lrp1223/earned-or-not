<!--pages/stats/stats.wxml-->
<view class="container">
  <!-- 年度总盈亏：无卡片头区，与首页同语言 -->
  <view class="summary">
    <view class="summary-title">年度总盈亏</view>
    <view class="summary-amount" style="color: {{stats.totalNet >= 0 ? winColor : loseColor}}">
      {{stats.totalNet >= 0 ? '+' : ''}}{{stats.totalNet}}<text class="summary-unit">元</text>
    </view>
  </view>

  <!-- 彩 -->
  <view class="card" bindtap="goRecordList" data-type="lottery">
    <view class="stat-row">
      <view class="stat-head">
        <view class="stat-icon lottery">🎟️</view>
        <text class="stat-title">彩</text>
      </view>
      <view class="stat-right">
        <text class="stat-net" style="color: {{stats.lottery.net >= 0 ? winColor : loseColor}}">{{stats.lottery.net >= 0 ? '+' : ''}}{{stats.lottery.net}} 元</text>
        <text class="stat-arrow">查看全部 ›</text>
      </view>
    </view>
  </view>

  <!-- 刮 -->
  <view class="card" bindtap="goRecordList" data-type="scratch">
    <view class="stat-row">
      <view class="stat-head">
        <view class="stat-icon scratch">🎫</view>
        <text class="stat-title">刮</text>
      </view>
      <view class="stat-right">
        <text class="stat-net" style="color: {{stats.scratch.net >= 0 ? winColor : loseColor}}">{{stats.scratch.net >= 0 ? '+' : ''}}{{stats.scratch.net}} 元</text>
        <text class="stat-arrow">查看全部 ›</text>
      </view>
    </view>
  </view>

  <!-- 麻将 -->
  <view class="card" bindtap="goRecordList" data-type="mahjong">
    <view class="stat-row">
      <view class="stat-head">
        <view class="stat-icon mahjong">🀄</view>
        <text class="stat-title">麻将</text>
      </view>
      <view class="stat-right">
        <text class="stat-net" style="color: {{stats.mahjong.net >= 0 ? winColor : loseColor}}">{{stats.mahjong.net >= 0 ? '+' : ''}}{{stats.mahjong.net}} 元</text>
        <text class="stat-arrow">查看全部 ›</text>
      </view>
    </view>
  </view>
</view>
