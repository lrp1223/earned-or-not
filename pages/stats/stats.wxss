/**pages/stats/stats.wxss**/
/* 年度总盈亏头区：无卡片，直接铺页面底色，与首页问候区同语言 */
.summary { padding: 20rpx 10rpx 12rpx; }
.summary-title { font-size: 26rpx; color: #888; }
.summary-amount { font-size: 72rpx; font-weight: bold; margin-top: 6rpx; line-height: 1.15; font-variant-numeric: tabular-nums; }
.summary-unit { font-size: 26rpx; font-weight: normal; margin-left: 8rpx; }

/* 分类卡片：浅色底纹图标块 + 右侧金额/入口 */
.stat-row { display: flex; justify-content: space-between; align-items: center; }
.stat-head { display: flex; align-items: center; }
.stat-icon { width: 76rpx; height: 76rpx; border-radius: 26rpx; display: flex; align-items: center; justify-content: center; font-size: 38rpx; margin-right: 20rpx; flex-shrink: 0; }
.stat-icon.lottery { background: var(--primary-tint); }
.stat-icon.scratch { background: #e4f6f3; }
.stat-icon.mahjong { background: #fdf3dc; }
.stat-title { font-size: 30rpx; font-weight: 600; color: #333; }

.stat-right { text-align: right; }
.stat-net { font-size: 36rpx; font-weight: bold; display: block; font-variant-numeric: tabular-nums; }
.stat-arrow { font-size: 22rpx; color: #999; margin-top: 4rpx; display: block; }
