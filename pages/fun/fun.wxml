<!--pages/fun/fun.wxml-->
<view class="container">
  <view class="header">
    <text class="title">🎮 趣玩</text>
    <text class="subtitle">休闲娱乐小游戏</text>
  </view>

  <view class="game-list">
    <view class="game-card hot" bindtap="goAlmostWin">
      <view class="hot-tag">🔥 最火</view>
      <view class="game-icon">🎯</view>
      <view class="game-info">
        <text class="game-name">🎲 手气测试</text>
        <text class="game-desc">刮开3个数，测测今天手气！70%的人差一点...</text>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="game-card" bindtap="goIdiomGame">
      <view class="game-icon">📚</view>
      <view class="game-info">
        <text class="game-name">成语接龙</text>
        <text class="game-desc">世界读书日特别版，挑战你的成语储备！</text>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="game-card" bindtap="goFeihuaGame">
      <view class="game-icon">🌸</view>
      <view class="game-info">
        <text class="game-name">飞花令</text>
        <text class="game-desc">说出含关键字的诗句，与AI一决高下！</text>
      </view>
      <text class="arrow">›</text>
    </view>
    <view class="game-card" bindtap="goGame24">
      <view class="game-icon">🃏</view>
      <view class="game-info">
        <text class="game-name">二十四点</text>
        <text class="game-desc">用4张牌算出24，挑战你的大脑</text>
      </view>
      <text class="arrow">›</text>
    </view>
  </view>

  <view class="footer">更多游戏开发中...</view>
</view>
