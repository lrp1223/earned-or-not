.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #fff5f5 0%, #ffffff 100%);
  padding: 24rpx;
}
.header {
  text-align: center;
  padding: 30rpx 0;
}
.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #ff6b6b;
  display: block;
}
.subtitle {
  font-size: 24rpx;
  color: #999;
  margin-top: 12rpx;
  display: block;
}
.game-list {
  margin-top: 20rpx;
  display: flex;
  flex-direction: column;
  gap: 16rpx;
}
.game-card {
  position: relative;
}
.hot-tag {
  position: absolute;
  top: -8rpx;
  right: 16rpx;
  background: #ff4d4f;
  color: white;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}
.new-tag {
  position: absolute;
  top: -8rpx;
  right: 16rpx;
  background: #52c41a;
  color: white;
  font-size: 20rpx;
  padding: 4rpx 12rpx;
  border-radius: 16rpx;
}
.hot {
  border: 2rpx solid #ff4d4f;
}
.new {
  border: 2rpx solid #52c41a;
}
.game-card {
  background: white;
  border-radius: 24rpx;
  padding: 28rpx;
  display: flex;
  align-items: center;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 107, 0.12);
}
.game-icon {
  font-size: 64rpx;
  margin-right: 24rpx;
}
.game-info {
  flex: 1;
}
.game-name {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
  display: block;
}
.game-desc {
  font-size: 24rpx;
  color: #999;
  margin-top: 8rpx;
  display: block;
}
.arrow {
  font-size: 44rpx;
  color: #ccc;
}
.footer {
  text-align: center;
  padding: 40rpx 0;
  font-size: 24rpx;
  color: #bbb;
}
