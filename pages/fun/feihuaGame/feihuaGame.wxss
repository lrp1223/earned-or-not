.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #fff0f6 0%, #ffffff 100%);
  padding: 30rpx;
}
.header {
  text-align: center;
  padding: 30rpx 0;
}
.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #eb2f96;
  display: block;
}
.subtitle {
  font-size: 26rpx;
  color: #999;
  margin-top: 10rpx;
  display: block;
}

/* 准备界面 */
.ready-screen {
  text-align: center;
  padding: 40rpx 0;
}
.intro {
  background: white;
  border-radius: 24rpx;
  padding: 50rpx 40rpx;
  margin-bottom: 40rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.06);
}
.intro-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}
.intro-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 30rpx;
}
.intro-text {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin: 16rpx 0;
}
.btn-start {
  width: 80%;
  height: 100rpx;
  line-height: 100rpx;
  background: linear-gradient(135deg, #eb2f96 0%, #ff69b4 100%);
  color: white;
  font-size: 36rpx;
  font-weight: bold;
  border-radius: 50rpx;
  border: none;
  box-shadow: 0 12rpx 40rpx rgba(235, 47, 150, 0.4);
}
.keys-preview {
  margin-top: 40rpx;
}
.keys-label {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 16rpx;
}
.keys-list {
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 16rpx;
}
.key-item {
  width: 60rpx;
  height: 60rpx;
  line-height: 60rpx;
  background: #fff0f6;
  border-radius: 12rpx;
  font-size: 32rpx;
  color: #eb2f96;
}
.high-score {
  margin-top: 30rpx;
  font-size: 28rpx;
  color: #999;
}

/* 游戏界面 */
.game-screen {
  padding: 20rpx 0;
}
.status-bar {
  display: flex;
  justify-content: space-around;
  background: white;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.status-item {
  text-align: center;
}
.status-label {
  font-size: 22rpx;
  color: #999;
  display: block;
}
.status-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-top: 8rpx;
  display: block;
}
.status-value.title {
  font-size: 28rpx;
  color: #eb2f96;
}
.status-value.danger {
  color: #ff4d4f;
  animation: blink 0.5s infinite;
}
@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

/* 关键字 */
.key-box {
  background: white;
  border-radius: 24rpx;
  padding: 40rpx;
  text-align: center;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.key-label {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 20rpx;
}
.key-char {
  font-size: 120rpx;
  font-weight: bold;
  color: #eb2f96;
  display: block;
  text-shadow: 4rpx 4rpx 8rpx rgba(235, 47, 150, 0.3);
}
.key-hint {
  font-size: 26rpx;
  color: #666;
  margin-top: 20rpx;
  display: block;
}

/* 输入区 */
.input-area {
  display: flex;
  gap: 20rpx;
  margin: 30rpx 0;
}
.poem-input {
  flex: 1;
  height: 100rpx;
  background: white;
  border-radius: 16rpx;
  padding: 0 30rpx;
  font-size: 32rpx;
  border: 2rpx solid #e8e8e8;
}
.btn-submit {
  width: 160rpx;
  height: 100rpx;
  line-height: 100rpx;
  background: linear-gradient(135deg, #eb2f96 0%, #ff69b4 100%);
  color: white;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 16rpx;
  border: none;
}
.btn-change {
  width: 100%;
  height: 80rpx;
  line-height: 80rpx;
  background: #f5f5f5;
  color: #666;
  font-size: 28rpx;
  border-radius: 40rpx;
  border: none;
  margin-bottom: 30rpx;
}

/* 历史记录 */
.history {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  max-height: 400rpx;
}
.history-label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 20rpx;
  display: block;
}
.history-scroll {
  max-height: 300rpx;
}
.history-item {
  display: flex;
  padding: 16rpx 0;
  border-bottom: 1rpx solid #f0f0f0;
}
.history-item:last-child {
  border-bottom: none;
}
.history-type {
  width: 60rpx;
  font-size: 24rpx;
  color: #999;
}
.history-item.player .history-type {
  color: #eb2f96;
  font-weight: bold;
}
.history-text {
  flex: 1;
  font-size: 30rpx;
  color: #333;
}

/* 结束界面 */
.over-screen {
  text-align: center;
  padding: 60rpx 0;
}
.over-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 30rpx;
}
.over-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}
.over-text {
  font-size: 32rpx;
  color: #666;
  display: block;
  margin-bottom: 40rpx;
}
.over-stats {
  background: linear-gradient(135deg, #fff0f6 0%, #fff5f5 100%);
  border-radius: 20rpx;
  padding: 40rpx;
  margin: 40rpx 0;
}
.stats-title {
  font-size: 28rpx;
  color: #eb2f96;
  display: block;
  margin-bottom: 16rpx;
}
.stats-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #eb2f96;
  display: block;
}
.btn-restart {
  width: 80%;
  height: 100rpx;
  line-height: 100rpx;
  background: linear-gradient(135deg, #eb2f96 0%, #ff69b4 100%);
  color: white;
  font-size: 36rpx;
  font-weight: bold;
  border-radius: 50rpx;
  border: none;
  margin-top: 40rpx;
}
