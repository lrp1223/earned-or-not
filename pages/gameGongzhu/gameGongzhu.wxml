<!--pages/gameGongzhu/gameGongzhu.wxml-->
<view class="container">
  <!-- 横屏布局 -->
  <view class="landscape-layout">
    <!-- 左侧玩家 AI-1（上家） -->
    <view class="side-player left-player">
      <view class="player-avatar {{currentPlayer === 1 ? 'active' : ''}}">
        <text class="avatar-icon">🤖</text>
        <text class="player-name">上家</text>
        <text class="player-score">{{scores[1]}}</text>
      </view>
      <view class="card-back-stack">
        <text class="card-count">{{aiHands[0] ? aiHands[0].length : 13}}张</text>
      </view>
    </view>

    <!-- 中间区域 -->
    <view class="center-area">
      <!-- 顶部玩家 AI-2（对家） -->
      <view class="top-player">
        <view class="player-avatar {{currentPlayer === 2 ? 'active' : ''}}">
          <text class="avatar-icon">🤖</text>
          <text class="player-name">对家</text>
          <text class="player-score">{{scores[2]}}</text>
        </view>
        <view class="card-back-stack">
          <text class="card-count">{{aiHands[1] ? aiHands[1].length : 13}}张</text>
        </view>
      </view>

      <!-- 桌面出牌区 -->
      <view class="table-area">
        <view class="table-center">
          <view class="played-card {{item.player === 0 ? 'player-card' : ''}} {{item.player === 1 ? 'left-card' : ''}} {{item.player === 2 ? 'top-card' : ''}} {{item.player === 3 ? 'right-card' : ''}}" 
                wx:for="{{tableCards}}" 
                wx:key="index">
            <text class="card-suit {{item.card.suit === '♥' || item.card.suit === '♦' ? 'red' : ''}}">{{item.card.suit}}</text>
            <text class="card-rank">{{item.card.rank}}</text>
          </view>
        </view>
        
        <!-- 轮次信息 -->
        <view class="round-info" wx:if="{{gameState === 'playing'}}">
          <text>第 {{currentRound}}/13 轮</text>
          <text wx:if="{{leadSuit}}">主:{{leadSuit}}</text>
        </view>
      </view>

      <!-- 底部玩家（你） -->
      <view class="bottom-player" wx:if="{{gameState === 'playing'}}">
        <view class="player-hand">
          <view class="hand-card {{selectedCard === index ? 'selected' : ''}} {{!isValidPlay(item, playerHand) ? 'disabled' : ''}}" 
                wx:for="{{playerHand}}" 
                wx:key="index"
                bindtap="selectCard"
                data-index="{{index}}">
            <text class="card-suit {{item.suit === '♥' || item.suit === '♦' ? 'red' : ''}}">{{item.suit}}</text>
            <text class="card-rank">{{item.rank}}</text>
          </view>
        </view>
        <view class="player-info">
          <view class="player-avatar {{currentPlayer === 0 ? 'active' : ''}}">
            <text class="avatar-icon">😀</text>
            <text class="player-name">你</text>
            <text class="player-score">{{scores[0]}}</text>
          </view>
          <button class="btn-play" bindtap="confirmPlay" disabled="{{selectedCard === null}}">出牌</button>
        </view>
      </view>
    </view>

    <!-- 右侧玩家 AI-3（下家） -->
    <view class="side-player right-player">
      <view class="player-avatar {{currentPlayer === 3 ? 'active' : ''}}">
        <text class="avatar-icon">🤖</text>
        <text class="player-name">下家</text>
        <text class="player-score">{{scores[3]}}</text>
      </view>
      <view class="card-back-stack">
        <text class="card-count">{{aiHands[2] ? aiHands[2].length : 13}}张</text>
      </view>
    </view>
  </view>

  <!-- 准备界面 -->
  <view class="ready-screen" wx:if="{{gameState === 'ready'}}">
    <view class="intro">
      <text class="intro-icon">🐷</text>
      <text class="intro-title">拱猪</text>
      <view class="intro-rules">
        <text>♠Q 猪 = -100分</text>
        <text>♥ 红桃 = -10至-50分</text>
        <text>♦J 变压器 = +100分</text>
        <text>收齐所有红桃变正分</text>
      </view>
    </view>
    <button class="btn-start" bindtap="startGame">开始游戏</button>
  </view>

  <!-- 游戏结束 -->
  <view class="game-over" wx:if="{{gameState === 'over'}}">
    <text class="over-icon">{{scores[0] > 0 ? '🎉' : '😅'}}</text>
    <text class="over-title">{{scores[0] > 0 ? '你赢了！' : '你输了...'}}</text>
    <text class="over-score">你的得分: {{scores[0]}}</text>
    <text class="over-rank">排名: 第{{[...scores].sort((a,b)=>b-a).indexOf(scores[0])+1}}名</text>
    <button class="btn-restart" bindtap="restart">再来一局</button>
  </view>
</view>
