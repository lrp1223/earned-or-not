<!--pages/gameGongzhu/gameGongzhu.wxml-->
<view class="page-container">
  <!-- 1. 准备界面 (全屏固定高度) -->
  <view class="ready-screen" wx:if="{{gameState === 'ready'}}">
    <view class="ready-box-left">
      <view class="title-wrap">
        <text class="emoji-main">🐷</text>
        <text class="text-title">拱猪</text>
        <text class="text-subtitle">2V2 组队版</text>
      </view>
      <view class="btn-primary-start" bindtap="startGame">开始游戏</view>
    </view>
    
    <view class="ready-box-right">
      <view class="rule-card-white">
        <view class="rule-row-inline">
          <view class="item-rule"><text class="suit-s">♠</text><text>Q猪</text><text class="val">-100</text></view>
          <view class="item-rule"><text class="suit-d">♦</text><text>J羊</text><text class="val">+100</text></view>
        </view>
        <view class="rule-row-inline">
          <view class="item-rule"><text class="suit-h">♥</text><text>红桃</text><text class="val">-10~-50</text></view>
          <view class="item-rule"><text class="suit-c">♣</text><text>10变压</text><text class="val">×2</text></view>
        </view>
        <view class="rule-row-full">
          <text>满红13张</text><text class="val">+200</text>
        </view>
        <view class="rule-bottom-note">猪羊定队，队友分数平均</view>
      </view>
    </view>
  </view>

  <!-- 2. 游戏界面 (全屏固定高度) -->
  <view class="game-screen-fixed" wx:if="{{gameState === 'playing' || gameState === 'over'}}">
    <!-- 顶部栏 (5vh) -->
    <view class="bar-top">
      <text class="tag-status">第{{currentRound}}/13轮</text>
      <text class="tag-status" wx:if="{{leadSuit}}">主{{leadSuit}}</text>
      <text class="tag-status">{{teams ? '已组队' : '待组队'}}</text>
    </view>

    <!-- 中间牌桌 (60vh) -->
    <view class="board-middle">
      <!-- 玩家: 对家 -->
      <view class="seat-pos seat-top-mid">
        <view class="u-info {{currentPlayer === 2 ? 'u-active' : ''}}">
          <view class="u-avatar">🤖</view>
          <text class="u-name">对家</text>
          <text class="u-score">{{teamScores[2]}}</text>
          <text class="u-team" wx:if="{{teams && teams[2] === 0}}">友</text>
        </view>
        <text class="u-cards-tip">{{aiHands[1] ? aiHands[1].length : 13}}</text>
      </view>

      <!-- 玩家: 左侧下家 -->
      <view class="seat-pos seat-left-mid">
        <view class="u-info {{currentPlayer === 3 ? 'u-active' : ''}}">
          <view class="u-avatar">🤖</view>
          <text class="u-name">下家</text>
          <text class="u-score">{{teamScores[3]}}</text>
          <text class="u-team" wx:if="{{teams && teams[3] === 0}}">友</text>
        </view>
        <text class="u-cards-tip">{{aiHands[2] ? aiHands[2].length : 13}}</text>
      </view>

      <!-- 玩家: 右侧上家 -->
      <view class="seat-pos seat-right-mid">
        <view class="u-info {{currentPlayer === 1 ? 'u-active' : ''}}">
          <view class="u-avatar">🤖</view>
          <text class="u-name">上家</text>
          <text class="u-score">{{teamScores[1]}}</text>
          <text class="u-team" wx:if="{{teams && teams[1] === 0}}">友</text>
        </view>
        <text class="u-cards-tip">{{aiHands[0] ? aiHands[0].length : 13}}</text>
      </view>

      <!-- 桌面中心 -->
      <view class="center-table-cards">
        <view class="played-card-box {{item.player === 0 ? 'p-b' : item.player === 1 ? 'p-r' : item.player === 2 ? 'p-t' : 'p-l'}}" 
              wx:for="{{tableCards}}" wx:key="index">
          <text class="p-suit {{item.card.suit === '♥' || item.card.suit === '♦' ? 'p-red' : ''}}">{{item.card.suit}}</text>
          <text class="p-rank">{{item.card.rank}}</text>
        </view>
      </view>

      <!-- 玩家: 自己 (位置上抬不被挡) -->
      <view class="seat-pos seat-bottom-mid" wx:if="{{gameState === 'playing'}}">
        <view class="u-info {{currentPlayer === 0 ? 'u-active' : ''}}">
          <view class="u-avatar">😀</view>
          <text class="u-name">你</text>
          <text class="u-score">{{teamScores[0]}}</text>
          <text class="u-team" wx:if="{{teams}}">{{teams[0] === 2 ? '对' : teams[0] === 3 ? '下' : '上'}}</text>
        </view>
      </view>
    </view>

    <!-- 底部区域 (35vh) -->
    <view class="area-bottom-hand" wx:if="{{gameState === 'playing'}}">
      <view class="btn-row-action">
        <view class="btn-confirm-play {{selectedCard !== null ? 'btn-enabled' : ''}}" bindtap="confirmPlay">出牌</view>
      </view>
      
      <view class="hand-view-center">
        <view class="hand-card-stack">
          <view class="h-card-item {{selectedCard === index ? 'h-selected' : ''}} {{!isValidPlay(item, playerHand) ? 'h-disabled' : ''}}" 
                style="left: {{ (100 - ( (playerHand.length - 1) * 4 + 12 )) / 2 + index * 4 }}vw; z-index: {{index}};"
                wx:for="{{playerHand}}" wx:key="index"
                bindtap="selectCard" data-index="{{index}}">
            <text class="h-suit {{item.suit === '♥' || item.suit === '♦' ? 'p-red' : ''}}">{{item.suit}}</text>
            <text class="h-rank">{{item.rank}}</text>
          </view>
        </view>
      </view>
    </view>

    <!-- 结算浮层 -->
    <view class="mask-overlay" wx:if="{{gameState === 'over'}}">
      <view class="box-result">
        <text class="ico-result">{{gameResult.rank === 1 ? '🏆' : '💔'}}</text>
        <text class="tit-result">{{gameResult.rank === 1 ? '冠军' : '再接再厉'}}</text>
        <text class="num-result">{{gameResult.playerScore}}分</text>
        <view class="btn-primary-start" bindtap="restart">重开一局</view>
      </view>
    </view>
  </view>
</view>
