<!--pages/gameGongzhu/gameGongzhu.wxml-->
<view class="container">
  <!-- 准备界面 -->
  <view class="ready-screen" wx:if="{{gameState === 'ready'}}" catchtouchmove="true">
    <view class="intro">
      <text class="intro-icon">🐷</text>
      <text class="intro-title">拱猪</text>
      <view class="intro-rules">
        <text>♠Q 猪=-100 ♦J 羊=+100</text>
        <text>♥ 红桃=-10至-50</text>
        <text>♣10 变压器=×2 或 +50</text>
      </view>
    </view>
    <view class="btn-wrapper" bindtap="startGame">
      <text class="btn-start-text">开始游戏</text>
    </view>
  </view>

  <!-- 游戏界面 -->
  <view class="game-screen" wx:if="{{gameState === 'playing' || gameState === 'over'}}">
    <!-- 顶部：对家 -->
    <view class="top-section">
      <view class="player-avatar {{currentPlayer === 2 ? 'active' : ''}}">
        <text class="avatar-icon">🤖</text>
        <text class="player-name">对家</text>
        <text class="player-score">{{scores[2]}}</text>
      </view>
      <view class="card-back">
        <text class="card-count">{{aiHands[1] ? aiHands[1].length : 13}}张</text>
      </view>
    </view>

    <!-- 中间：桌面 + 左右家 -->
    <view class="middle-section">
      <!-- 左家 -->
      <view class="side-player">
        <view class="player-avatar {{currentPlayer === 1 ? 'active' : ''}}">
          <text class="avatar-icon">🤖</text>
          <text class="player-name">上家</text>
          <text class="player-score">{{scores[1]}}</text>
        </view>
        <view class="card-back small">
          <text class="card-count">{{aiHands[0] ? aiHands[0].length : 13}}</text>
        </view>
      </view>

      <!-- 桌面 -->
      <view class="table-area">
        <view class="round-info">
          <text>第{{currentRound}}/13轮</text>
          <text wx:if="{{leadSuit}}">主{{leadSuit}}</text>
        </view>
        <view class="table-cards">
          <view class="played-card {{item.player === 0 ? 'bottom' : item.player === 1 ? 'left' : item.player === 2 ? 'top' : 'right'}}" 
                wx:for="{{tableCards}}" 
                wx:key="index">
            <text class="card-suit {{item.card.suit === '♥' || item.card.suit === '♦' ? 'red' : ''}}">{{item.card.suit}}</text>
            <text class="card-rank">{{item.card.rank}}</text>
          </view>
        </view>
      </view>

      <!-- 右家 -->
      <view class="side-player">
        <view class="player-avatar {{currentPlayer === 3 ? 'active' : ''}}">
          <text class="avatar-icon">🤖</text>
          <text class="player-name">下家</text>
          <text class="player-score">{{scores[3]}}</text>
        </view>
        <view class="card-back small">
          <text class="card-count">{{aiHands[2] ? aiHands[2].length : 13}}</text>
        </view>
      </view>
    </view>

    <!-- 底部：玩家 -->
    <view class="bottom-section" wx:if="{{gameState === 'playing'}}">
      <view class="player-info-row">
        <view class="player-avatar {{currentPlayer === 0 ? 'active' : ''}}">
          <text class="avatar-icon">😀</text>
          <text class="player-name">你</text>
          <text class="player-score">{{scores[0]}}</text>
        </view>
        <view class="btn-play-wrapper" bindtap="confirmPlay">
          <text class="btn-play-text" wx:if="{{selectedCard !== null}}">出牌</text>
          <text class="btn-play-text" wx:else>选牌</text>
        </view>
      </view>
      <scroll-view class="hand-scroll" scroll-x="true">
        <view class="player-hand">
          <view class="hand-card {{selectedCard === index ? 'selected' : ''}} {{!isValidPlay(item, playerHand) ? 'disabled' : ''}}" 
                wx:for="{{playerHand}}" 
                wx:key="index"
                bindtap="selectCard"
                data-index="{{index}}">
            <text class="card-suit {{item.suit === '♥' || item.suit === '♦' ? 'red' : ''}}">{{item.suit}}</text>
            <text class="card-rank">{{item.rank}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 游戏结束 -->
    <view class="game-over" wx:if="{{gameState === 'over'}}">
      <text class="over-icon">{{gameResult.playerScore > 0 ? '🎉' : '😅'}}</text>
      <text class="over-title">{{gameResult.result}}</text>
      <text class="over-score">得分: {{gameResult.playerScore}}</text>
      <text class="over-rank">排名: 第{{gameResult.rank}}名</text>
      <view class="btn-wrapper" bindtap="restart">
        <text class="btn-start-text">再来一局</text>
      </view>
    </view>
  </view>
</view>
