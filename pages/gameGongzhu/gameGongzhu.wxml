<!--pages/gameGongzhu/gameGongzhu.wxml-->
<view class="container">
  <!-- 准备界面 -->
  <view class="ready-screen" wx:if="{{gameState === 'ready'}}">
    <view class="ready-box">
      <text class="ready-title">🐷 拱猪</text>
      <text class="ready-subtitle">2v2组队版</text>
      <view class="rules">
        <text>♠Q猪=-100 ♦J羊=+100</text>
        <text>♥红桃=-10至-50 ♣10变压器=×2</text>
        <text>满红13张=+200 大满贯翻倍</text>
        <text>猪羊定队，队友分数平分</text>
      </view>
      <view class="start-btn" bindtap="startGame">开始游戏</view>
    </view>
  </view>

  <!-- 游戏界面 -->
  <view class="game-screen" wx:if="{{gameState === 'playing' || gameState === 'over'}}">
    <!-- 顶部信息 -->
    <view class="top-info">
      <text class="round">第{{currentRound}}/13轮</text>
      <text wx:if="{{leadSuit}}" class="suit">主{{leadSuit}}</text>
      <text wx:if="{{teams}}" class="team-status">队伍已分</text>
      <text wx:else class="team-status">等猪羊</text>
    </view>

    <!-- 对家 -->
    <view class="player player-top">
      <view class="avatar-box {{currentPlayer === 2 ? 'active' : ''}}">
        <view class="avatar">🤖</view>
        <text class="name">对家</text>
        <text class="score">{{teamScores[2]}}</text>
        <text class="team-tag" wx:if="{{teams && teams[2] === 0}}">队友</text>
      </view>
      <view class="card-count">{{aiHands[1] ? aiHands[1].length : 13}}张</view>
    </view>

    <!-- 左家 -->
    <view class="player player-left">
      <view class="avatar-box {{currentPlayer === 3 ? 'active' : ''}}">
        <view class="avatar">🤖</view>
        <text class="name">下家</text>
        <text class="score">{{teamScores[3]}}</text>
        <text class="team-tag" wx:if="{{teams && teams[3] === 0}}">队友</text>
      </view>
      <view class="card-count">{{aiHands[2] ? aiHands[2].length : 13}}张</view>
    </view>

    <!-- 右家 -->
    <view class="player player-right">
      <view class="avatar-box {{currentPlayer === 1 ? 'active' : ''}}">
        <view class="avatar">🤖</view>
        <text class="name">上家</text>
        <text class="score">{{teamScores[1]}}</text>
        <text class="team-tag" wx:if="{{teams && teams[1] === 0}}">队友</text>
      </view>
      <view class="card-count">{{aiHands[0] ? aiHands[0].length : 13}}张</view>
    </view>

    <!-- 桌面 -->
    <view class="table-area">
      <view class="table-cards">
        <view class="card-played {{item.player === 0 ? 'pos-bottom' : item.player === 1 ? 'pos-right' : item.player === 2 ? 'pos-top' : 'pos-left'}}" 
              wx:for="{{tableCards}}" wx:key="index">
          <text class="suit {{item.card.suit === '♥' || item.card.suit === '♦' ? 'red' : ''}}">{{item.card.suit}}</text>
          <text class="rank">{{item.card.rank}}</text>
        </view>
      </view>
    </view>

    <!-- 自己 -->
    <view class="player-self" wx:if="{{gameState === 'playing'}}">
      <view class="self-info">
        <view class="avatar-box {{currentPlayer === 0 ? 'active' : ''}}">
          <view class="avatar">😀</view>
          <text class="name">你</text>
          <text class="score">{{teamScores[0]}}</text>
          <text class="team-tag" wx:if="{{teams}}">{{teams[0] === 2 ? '对' : teams[0] === 3 ? '下' : '上'}}</text>
        </view>
        <view class="play-btn {{selectedCard !== null ? 'active' : ''}}" bindtap="confirmPlay">出牌</view>
      </view>
      <scroll-view class="hand-scroll" scroll-x="true">
        <view class="hand">
          <view class="hand-card {{selectedCard === index ? 'selected' : ''}} {{!isValidPlay(item, playerHand) ? 'disabled' : ''}}" 
                wx:for="{{playerHand}}" wx:key="index"
                bindtap="selectCard" data-index="{{index}}">
            <text class="suit {{item.suit === '♥' || item.suit === '♦' ? 'red' : ''}}">{{item.suit}}</text>
            <text class="rank">{{item.rank}}</text>
          </view>
        </view>
      </scroll-view>
    </view>

    <!-- 结束界面 -->
    <view class="over-screen" wx:if="{{gameState === 'over'}}">
      <text class="over-icon">{{gameResult.rank === 1 ? '🏆' : gameResult.rank === 2 ? '🥈' : gameResult.rank === 3 ? '🥉' : '💔'}}</text>
      <text class="over-title">{{gameResult.rank === 1 ? '冠军' : gameResult.rank === 2 ? '亚军' : gameResult.rank === 3 ? '季军' : '垫底'}}</text>
      <text class="over-score">{{gameResult.playerScore}}分</text>
      <view class="start-btn" bindtap="restart">再来一局</view>
    </view>
  </view>
</view>
