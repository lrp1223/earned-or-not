<!--pages/gameGongzhu/gameGongzhu.wxml-->
<view class="container">
  <!-- 1. 准备界面 -->
  <view class="ready-screen" wx:if="{{gameState === 'ready'}}">
    <view class="ready-box-left-col">
      <view class="title-wrap-left">
        <text class="emoji-main">🐷</text>
        <view class="title-texts">
          <text class="text-title">拱猪</text>
          <text class="text-subtitle">经典组队版</text>
        </view>
      </view>
      
      <view class="rule-card-white-compact">
        <view class="rule-row-inline">
          <view class="item-rule"><text class="suit-s">♠</text><text>Q猪</text><text class="val">-100</text></view>
          <view class="item-rule"><text class="suit-d">♦</text><text>J羊</text><text class="val">+100</text></view>
        </view>
        <view class="rule-row-inline">
          <view class="item-rule"><text class="suit-h">♥</text><text>红桃</text><text class="val">-10~-50</text></view>
          <view class="item-rule"><text class="suit-c">♣</text><text>10变压</text><text class="val">×2</text></view>
        </view>
        <view class="rule-tip-bottom">起手定队 · 分数连局累加</view>
      </view>
    </view>
    
    <view class="ready-box-right-btn">
      <view class="btn-primary-start-large" bindtap="startGame">开始游戏</view>
    </view>
  </view>

  <!-- 2. 游戏界面 -->
  <view class="game-screen-fixed" wx:if="{{gameState === 'playing' || gameState === 'over'}}">
    <!-- 顶部 -->
    <view class="bar-top">
      <text class="tag-status">局:{{gameCount}} · 轮:{{currentRound}}/13</text>
      <text class="tag-status" wx:if="{{leadSuit}}">主: {{suitMap[leadSuit]}}</text>
    </view>

    <!-- 牌桌 -->
    <view class="board-middle">
      <block wx:for="{{[2, 3, 1, 0]}}" wx:for-item="idx" wx:key="idx">
        <view class="seat-pos seat-{{idx}}">
          <view class="u-info {{currentPlayer === idx ? 'u-active' : ''}}">
            <view class="u-avatar">{{idx === 0 ? '😀' : '🤖'}}</view>
            <text class="u-score">{{displayScores[idx]}}</text>
            <view class="u-ident-wrap">
              <text class="u-ident" wx:if="{{pigPlayer === idx}}">🐷</text>
              <text class="u-ident" wx:if="{{sheepPlayer === idx}}">🐑</text>
            </view>
          </view>
          <!-- 收牌区 -->
          <view class="u-collected-zone zone-{{idx}}" wx:if="{{collectedScoreCards[idx].length > 0}}">
            <view class="mini-card" wx:for="{{collectedScoreCards[idx]}}" wx:for-item="card" wx:key="index">
              <text class="{{card.suit === 'H' || card.suit === 'D' ? 'p-red' : ''}}">{{suitMap[card.suit]}}{{card.rank}}</text>
            </view>
          </view>
        </view>
      </block>

      <!-- 桌面已出的牌 -->
      <view class="center-table-cards">
        <view class="played-card-box {{item.player === 0 ? 'p-b' : item.player === 1 ? 'p-r' : item.player === 2 ? 'p-t' : 'p-l'}}" 
              wx:for="{{tableCards}}" wx:key="index">
          <text class="p-suit {{item.card.suit === 'H' || item.card.suit === 'D' ? 'p-red' : ''}}">{{suitMap[item.card.suit]}}</text>
          <text class="p-rank">{{item.card.rank}}</text>
        </view>
      </view>
    </view>

    <!-- 底部手牌区域 -->
    <view class="area-bottom-hand" wx:if="{{gameState === 'playing'}}">
      <view class="hand-view-center">
        <view class="hand-card-stack">
          <view class="h-card-item {{selectedCard === index ? 'h-selected' : ''}} {{!isValidPlay(item, playerHand) ? 'h-disabled' : ''}}" 
                style="left: {{ (750 - ( (playerHand.length - 1) * 40 + 80 )) / 2 + index * 40 }}rpx; z-index: {{index}};"
                wx:for="{{playerHand}}" wx:key="index"
                bindtap="selectCard" data-index="{{index}}">
            <view class="h-card-face">
              <text class="h-suit {{item.suit === 'H' || item.suit === 'D' ? 'p-red' : ''}}">{{suitMap[item.suit]}}</text>
              <text class="h-rank">{{item.rank}}</text>
              <text class="h-suit-mini {{item.suit === 'H' || item.suit === 'D' ? 'p-red' : ''}}">{{suitMap[item.suit]}}</text>
            </view>
          </view>
        </view>
      </view>
      <view class="btn-confirm-play {{selectedCard !== null ? 'btn-enabled' : ''}}" bindtap="confirmPlay">出牌</view>
    </view>

    <!-- 战报结算 -->
    <view class="mask-overlay" wx:if="{{gameState === 'over'}}">
      <view class="box-result-list">
        <view class="result-header">
          <text class="res-title">第 {{gameCount}} 局战报</text>
          <text class="res-subtitle">当前累计积分</text>
        </view>
        <view class="score-table">
          <view class="score-row head">
            <text class="col-p">排名</text>
            <text class="col-raw">收牌</text>
            <text class="col-s">本局</text>
            <text class="col-t">总分</text>
          </view>
          <block wx:for="{{gameResult.sortedRank}}" wx:for-item="item" wx:key="idx">
            <view class="score-row {{item.idx === 0 ? 'me' : ''}}">
              <text class="col-p">{{item.isLast ? '🐷' : (item.rank === 1 ? '🥇' : (item.rank === 2 ? '🥈' : (item.rank === 3 ? '🥉' : '')))}} {{item.idx === 0 ? '你' : (item.idx === 1 ? '上家' : (item.idx === 2 ? '对家' : '下家'))}}{{gameResult.initialPigPlayer === item.idx ? '🐷' : ''}}{{gameResult.initialSheepPlayer === item.idx ? '🐑' : ''}}</text>
              <text class="col-raw">{{item.optimized}}</text>
              <text class="col-s {{item.thisGame >= 0 ? 'plus' : 'minus'}}">{{item.thisGame}}</text>
              <text class="col-t">{{item.total}}</text>
            </view>
          </block>
        </view>
        <view class="result-actions">
          <view class="btn-res next" bindtap="nextGame">下一局</view>
          <view class="btn-res exit" bindtap="restart">结束</view>
        </view>
      </view>
    </view>
  </view>
</view>
