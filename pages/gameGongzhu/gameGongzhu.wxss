.container {
  width: 100vw;
  height: 100vh;
  background: linear-gradient(135deg, #1a5f1a 0%, #2d7a2d 100%);
}

/* 准备界面 */
.ready-screen {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 2vh;
}
.ready-content {
  text-align: center;
}
.ready-title {
  font-size: 8vh;
  color: #fff;
  display: block;
}
.ready-subtitle {
  font-size: 3vh;
  color: #ccc;
  display: block;
  margin: 1vh 0 3vh;
}
.ready-rules {
  background: rgba(255,255,255,0.15);
  border-radius: 2vh;
  padding: 2vh 3vh;
}
.ready-rules text {
  display: block;
  font-size: 2.5vh;
  color: #fff;
  margin: 1vh 0;
}
.ready-btn {
  margin-top: 4vh;
  width: 20vh;
  height: 6vh;
  background: linear-gradient(135deg, #4caf50, #81c784);
  border-radius: 3vh;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 2.5vh;
  font-weight: bold;
}

/* 游戏界面 */
.game-screen {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
}

/* 顶部栏 */
.top-bar {
  height: 6vh;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 2vh;
  background: rgba(0,0,0,0.2);
}
.top-bar text {
  font-size: 2vh;
  color: #fff;
  background: rgba(0,0,0,0.3);
  padding: 0.5vh 1.5vh;
  border-radius: 1vh;
}

/* 游戏区 */
.game-area {
  flex: 1;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
  min-height: 0;
}

/* 玩家标签 */
.player-tag {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0.8vh 1.5vh;
  background: rgba(255,255,255,0.15);
  border-radius: 1vh;
  min-width: 8vh;
}
.player-tag.active {
  background: rgba(255,215,0,0.4);
  border: 0.3vh solid #ffd700;
}
.player-tag text {
  font-size: 2vh;
  color: #fff;
}
.player-tag .score {
  font-size: 3vh;
  font-weight: bold;
  color: #ffd700;
}
.player-tag .team-mark {
  font-size: 1.6vh;
  color: #4caf50;
  background: #e8f5e9;
  padding: 0.3vh 1vh;
  border-radius: 0.6vh;
  margin-top: 0.5vh;
}

/* 对家 */
.player-top {
  position: absolute;
  top: 2vh;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.player-top .card-num {
  font-size: 1.8vh;
  color: #ccc;
  margin-top: 1vh;
}

/* 左右家 */
.player-left {
  position: absolute;
  left: 2vh;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.player-right {
  position: absolute;
  right: 2vh;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.player-left .card-num, .player-right .card-num {
  font-size: 1.8vh;
  color: #ccc;
  margin-top: 1vh;
}

/* 桌面 */
.table {
  width: 55vh;
  height: 32vh;
  position: relative;
}
.table-card-wrap {
  width: 100%;
  height: 100%;
  position: relative;
}
.table-card {
  width: 8vh;
  height: 11vh;
  background: #fff;
  border-radius: 1vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: absolute;
  box-shadow: 0 0.5vh 1.5vh rgba(0,0,0,0.3);
}
.table-card .suit {
  font-size: 3.5vh;
}
.table-card .suit.red {
  color: #f44336;
}
.table-card .rank {
  font-size: 2.8vh;
  font-weight: bold;
  color: #333;
}
.table-card.pos-top {
  top: 0;
  left: 50%;
  transform: translateX(-50%);
}
.table-card.pos-bottom {
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
}
.table-card.pos-left {
  left: 0;
  top: 50%;
  transform: translateY(-50%);
}
.table-card.pos-right {
  right: 0;
  top: 50%;
  transform: translateY(-50%);
}

/* 底部区域 */
.bottom-area {
  height: 16vh;
  padding: 1vh 2vh 3vh;
  flex-shrink: 0;
}
.my-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 1vh;
}
.play-btn {
  width: 12vh;
  height: 5vh;
  background: #ccc;
  border-radius: 2.5vh;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 2.2vh;
  font-weight: bold;
  margin-right: 2vh;
}
.play-btn.active {
  background: linear-gradient(135deg, #ffd700, #ffaa00);
  color: #333;
}

/* 手牌 */
.hand-scroll {
  width: 100%;
  height: 9vh;
  white-space: nowrap;
}
.hand {
  display: inline-flex;
  gap: 0.8vh;
}
.hand-card {
  width: 6.5vh;
  height: 9vh;
  background: #fff;
  border-radius: 0.8vh;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 0.25vh solid transparent;
}
.hand-card .suit {
  font-size: 3vh;
}
.hand-card .rank {
  font-size: 2.2vh;
}
.hand-card.selected {
  border-color: #ffd700;
  transform: translateY(-1vh);
}
.hand-card.disabled {
  opacity: 0.4;
}
.hand-card .suit {
  font-size: 3.5vh;
}
.hand-card .suit.red {
  color: #f44336;
}
.hand-card .rank {
  font-size: 2.5vh;
  font-weight: bold;
  color: #333;
}

/* 结束界面 */
.over-screen {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.9);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.over-icon {
  font-size: 10vh;
  margin-bottom: 2vh;
}
.over-title {
  font-size: 5vh;
  font-weight: bold;
  color: #fff;
  margin-bottom: 2vh;
}
.over-score {
  font-size: 4vh;
  color: #ffd700;
  margin-bottom: 4vh;
}
