.container {
  width: 100vw;
  height: 100vh;
  background: linear-gradient(180deg, #1a5f1a 0%, #0d3d0d 100%);
}

/* 准备界面 */
.ready-screen {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ready-box {
  text-align: center;
  padding: 40rpx;
}
.ready-title {
  font-size: 80rpx;
  color: #fff;
  display: block;
  text-shadow: 4rpx 4rpx 8rpx rgba(0,0,0,0.5);
}
.ready-subtitle {
  font-size: 36rpx;
  color: #ffd700;
  display: block;
  margin: 20rpx 0 40rpx;
}
.rules {
  background: rgba(255,255,255,0.1);
  border-radius: 20rpx;
  padding: 30rpx;
  margin-bottom: 60rpx;
}
.rules text {
  display: block;
  font-size: 28rpx;
  color: #fff;
  margin: 16rpx 0;
}
.start-btn {
  width: 280rpx;
  height: 88rpx;
  background: linear-gradient(180deg, #ffd700 0%, #ffaa00 100%);
  border-radius: 44rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #333;
  font-size: 36rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 24rpx rgba(255, 170, 0, 0.4);
}

/* 游戏界面 */
.game-screen {
  width: 100%;
  height: 100%;
  position: relative;
}

/* 顶部信息 */
.top-info {
  position: absolute;
  top: 20rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 20rpx;
  z-index: 10;
}
.top-info text {
  font-size: 24rpx;
  color: #fff;
  background: rgba(0,0,0,0.4);
  padding: 10rpx 20rpx;
  border-radius: 20rpx;
}

/* 玩家通用 */
.player {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.avatar-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255,255,255,0.15);
  border-radius: 12rpx;
  padding: 10rpx 16rpx;
  border: 2rpx solid transparent;
}
.avatar-box.active {
  background: rgba(255,215,0,0.3);
  border-color: #ffd700;
}
.avatar {
  width: 56rpx;
  height: 56rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}
.name {
  font-size: 18rpx;
  color: #fff;
  margin-top: 4rpx;
}
.score {
  font-size: 26rpx;
  font-weight: bold;
  color: #ffd700;
  margin-top: 2rpx;
}
.team-tag {
  font-size: 16rpx;
  color: #4caf50;
  background: #e8f5e9;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  margin-top: 4rpx;
}
.card-count {
  font-size: 18rpx;
  color: #ccc;
  margin-top: 6rpx;
  background: rgba(0,0,0,0.3);
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

/* 对家 */
.player-top {
  top: 60rpx;
  left: 50%;
  transform: translateX(-50%);
}

/* 左右家 */
.player-left {
  left: 30rpx;
  top: 50%;
  transform: translateY(-50%);
}
.player-right {
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
}

/* 桌面 */
.table-area {
  position: absolute;
  top: 42%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 280rpx;
  height: 200rpx;
}
.table-cards {
  width: 100%;
  height: 100%;
  position: relative;
}
.card-played {
  width: 80rpx;
  height: 110rpx;
  background: #fff;
  border-radius: 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: absolute;
  box-shadow: 0 6rpx 18rpx rgba(0,0,0,0.3);
}
.card-played .suit {
  font-size: 36rpx;
}
.card-played .suit.red {
  color: #f44336;
}
.card-played .rank {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}
.card-played.pos-top {
  top: 0;
  left: 50%;
  transform: translateX(-50%);
}
.card-played.pos-bottom {
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
}
.card-played.pos-left {
  left: 0;
  top: 50%;
  transform: translateY(-50%);
}
.card-played.pos-right {
  right: 0;
  top: 50%;
  transform: translateY(-50%);
}

/* 自己 */
.player-self {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 8rpx 16rpx 20rpx;
  background: rgba(0,0,0,0.2);
}
.self-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 10rpx;
}
.play-btn {
  width: 120rpx;
  height: 56rpx;
  background: #999;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
}
.play-btn.active {
  background: linear-gradient(180deg, #ffd700 0%, #ffaa00 100%);
  color: #333;
}

/* 手牌 */
.hand-scroll {
  width: 100%;
  height: 130rpx;
  white-space: nowrap;
}
.hand {
  display: inline-flex;
  gap: 8rpx;
  padding: 5rpx 0;
}
.hand-card {
  width: 80rpx;
  height: 110rpx;
  background: #fff;
  border-radius: 10rpx;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 3rpx solid transparent;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.2);
}
.hand-card.selected {
  border-color: #ffd700;
  transform: translateY(-10rpx);
}
.hand-card.disabled {
  opacity: 0.4;
}
.hand-card .suit {
  font-size: 36rpx;
}
.hand-card .suit.red {
  color: #f44336;
}
.hand-card .rank {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
}

/* 结束界面 */
.over-screen {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.9);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.over-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}
.over-title {
  font-size: 60rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 20rpx;
}
.over-score {
  font-size: 48rpx;
  color: #ffd700;
  margin-bottom: 60rpx;
}
