.container {
  width: 100vw;
  height: 100vh;
  background: linear-gradient(180deg, #1a472a 0%, #2d5a27 100%);
  overflow: hidden;
}

/* 准备界面 */
.ready-screen {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.ready-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 80rpx;
}

.game-title {
  font-size: 80rpx;
  color: #fff;
  font-weight: bold;
  text-shadow: 0 4rpx 12rpx rgba(0,0,0,0.4);
}

.game-subtitle {
  font-size: 32rpx;
  color: rgba(255,255,255,0.85);
  margin-top: 16rpx;
  letter-spacing: 8rpx;
}

.start-btn {
  margin-top: 60rpx;
  background: linear-gradient(135deg, #ff6b35 0%, #ff8c42 100%);
  color: #fff;
  padding: 30rpx 80rpx;
  border-radius: 16rpx;
  font-size: 36rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 32rpx rgba(255,107,53,0.4);
}

.ready-right {
  background: rgba(255,255,255,0.95);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.2);
}

.rule-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #333;
  border-bottom: 1rpx solid rgba(0,0,0,0.06);
}

.rule-item:last-child {
  border-bottom: none;
}

.suit {
  font-size: 36rpx;
  margin-right: 16rpx;
  width: 40rpx;
  text-align: center;
}

.suit.red {
  color: #e53935;
}

.score {
  margin-left: auto;
  color: #d4a017;
  font-weight: 600;
}

/* 游戏界面 */
.game-screen {
  width: 100%;
  height: 100%;
  position: relative;
}

/* 顶部信息 */
.header {
  position: absolute;
  top: 10rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  gap: 10rpx;
  z-index: 100;
}

.info-tag {
  font-size: 20rpx;
  color: #fff;
  background: rgba(0,0,0,0.4);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

/* 玩家座位 - 整体缩小 */
.player-seat {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 50;
}

.seat-top {
  top: 60rpx;
  left: 50%;
  transform: translateX(-50%);
}

.seat-left {
  left: 20rpx;
  top: 40%;
  transform: translateY(-50%);
}

.seat-right {
  right: 20rpx;
  top: 40%;
  transform: translateY(-50%);
}

.seat-bottom {
  bottom: 220rpx; /* 上移，给手牌留空间 */
  left: 50%;
  transform: translateX(-50%);
}

.avatar-box {
  padding: 8rpx 16rpx;
}

.avatar {
  width: 50rpx;
  height: 50rpx;
  font-size: 30rpx;
}

.player-name { font-size: 18rpx; }
.player-score { font-size: 24rpx; }

/* 桌面 - 缩小 */
.table-area {
  position: absolute;
  top: 40%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 240rpx;
  height: 200rpx;
}

.played-card {
  width: 70rpx;
  height: 100rpx;
}
.card-suit { font-size: 32rpx; }
.card-rank { font-size: 24rpx; }

/* 手牌区域 - 重新设计 */
.hand-section {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 180rpx; /* 压缩高度 */
  background: rgba(0,0,0,0.4);
  display: flex;
  flex-direction: column; /* 垂直排列按钮和手牌 */
  align-items: center;
  padding-bottom: env(safe-area-inset-bottom);
}

.play-btn-area {
  margin-bottom: 10rpx;
  margin-left: 0; /* 居中 */
}

.play-btn {
  width: 120rpx;
  height: 50rpx;
  font-size: 26rpx;
}

.hand-container {
  width: 90%;
  height: 100rpx;
}

.hand-card {
  width: 70rpx;
  height: 100rpx;
}

.hand-card.selected {
  transform: translateY(-20rpx);
}

/* 结束界面 */
.result-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}

.result-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.result-icon {
  font-size: 140rpx;
  margin-bottom: 30rpx;
}

.result-title {
  font-size: 64rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 20rpx;
}

.result-score {
  font-size: 48rpx;
  color: #ffd700;
  margin-bottom: 50rpx;
}
