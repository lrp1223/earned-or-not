.container {
  width: 100vw;
  height: 100vh;
  background: linear-gradient(180deg, #1a472a 0%, #2d5a27 100%);
  overflow: hidden;
  box-sizing: border-box;
}

/* ========== 准备界面 - 横屏极致适配 ========== */
.ready-screen {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 10rpx 40rpx; 
  box-sizing: border-box;
  gap: 30rpx;
}

.ready-left {
  width: 35%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}

.title-section {
  text-align: center;
  margin-bottom: 20rpx;
}

.game-emoji {
  font-size: 60rpx;
  display: block;
  margin-bottom: 4rpx;
}

.game-title {
  font-size: 56rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 4rpx 10rpx rgba(0,0,0,0.4);
}

.game-subtitle {
  font-size: 22rpx;
  color: rgba(255,255,255,0.8);
  letter-spacing: 4rpx;
  margin-top: 4rpx;
  display: block;
}

.start-btn {
  background: linear-gradient(135deg, #ff6b35 0%, #ff8c42 100%);
  color: #fff;
  border-radius: 12rpx;
  padding: 20rpx 50rpx;
  font-size: 30rpx;
  font-weight: bold;
  box-shadow: 0 6rpx 20rpx rgba(255, 107, 53, 0.4);
}

.ready-right {
  width: 60%;
  max-width: 550rpx;
}

.rule-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 16rpx;
  padding: 16rpx 24rpx;
  box-shadow: 0 10rpx 30rpx rgba(0, 0, 0, 0.25);
}

.rule-item {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
  font-size: 22rpx;
  color: #333;
  border-bottom: 1rpx solid rgba(0,0,0,0.06);
}

.rule-item:last-child {
  border-bottom: none;
}

.suit {
  width: 32rpx;
  font-size: 30rpx;
  margin-right: 12rpx;
  text-align: center;
}

.suit.red { color: #e53935; }
.rule-text { flex: 1; }
.score-highlight { color: #d4a017; font-weight: bold; margin-left: 10rpx; }

.rule-note {
  font-size: 20rpx;
  color: #777;
  text-align: center;
  padding-top: 8rpx;
  border-top: 1rpx solid rgba(0,0,0,0.06);
  margin-top: 8rpx;
}

/* ========== 游戏界面 - 层级与间距修复 ========== */
.game-screen {
  width: 100%;
  height: 100%;
  position: relative;
}

/* 顶部信息 */
.header {
  position: absolute;
  top: 10rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  gap: 12rpx;
  z-index: 200;
}

.info-tag {
  font-size: 18rpx;
  color: #fff;
  background: rgba(0,0,0,0.4);
  padding: 6rpx 14rpx;
  border-radius: 16rpx;
}

/* 玩家座位 - 高层级 */
.player-seat {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 150; 
}

.seat-top { top: 60rpx; left: 50%; transform: translateX(-50%); }
.seat-left { left: 16rpx; top: 40%; transform: translateY(-50%); }
.seat-right { right: 16rpx; top: 40%; transform: translateY(-50%); }
.seat-bottom { bottom: 200rpx; left: 50%; transform: translateX(-50%); }

.avatar-box {
  background: rgba(255,255,255,0.2);
  border-radius: 10rpx;
  padding: 6rpx 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.avatar-box.active {
  background: rgba(255,215,0,0.3);
  border: 2rpx solid #ffd700;
}

.avatar { width: 44rpx; height: 44rpx; background: #fff; border-radius: 50%; display: flex; align-items: center; justify-content: center; font-size: 28rpx; }
.player-name { font-size: 16rpx; color: #fff; margin-top: 4rpx; }
.player-score { font-size: 22rpx; font-weight: bold; color: #ffd700; }
.team-badge { font-size: 14rpx; color: #4caf50; background: #e8f5e9; padding: 2rpx 6rpx; border-radius: 4rpx; margin-top: 2rpx; }
.card-count { font-size: 16rpx; color: #ccc; margin-top: 4rpx; }

/* 桌面 - 低层级 */
.table-area {
  position: absolute;
  top: 40%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 220rpx;
  height: 180rpx;
  z-index: 10;
}

.played-card {
  width: 60rpx;
  height: 84rpx;
  background: #fff;
  border-radius: 6rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: absolute;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.3);
}

.card-suit { font-size: 28rpx; }
.card-suit.red { color: #e53935; }
.card-rank { font-size: 20rpx; font-weight: bold; color: #333; }

.pos-top { top: 0; left: 50%; transform: translateX(-50%); }
.pos-bottom { bottom: 0; left: 50%; transform: translateX(-50%); }
.pos-left { left: 0; top: 50%; transform: translateY(-50%); }
.pos-right { right: 0; top: 50%; transform: translateY(-50%); }

/* 手牌区域 */
.hand-section {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 160rpx;
  background: rgba(0,0,0,0.4);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 250;
}

.play-btn-area { margin-bottom: 8rpx; }

.play-btn {
  width: 120rpx;
  height: 48rpx;
  background: #888;
  border-radius: 24rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 24rpx;
  font-weight: bold;
}

.play-btn.active {
  background: linear-gradient(135deg, #ffd700 0%, #ffaa00 100%);
  color: #333;
}

.hand-container {
  width: 680rpx;
  height: 90rpx;
  position: relative;
  display: flex;
  justify-content: center;
}

.hand-card {
  width: 64rpx;
  height: 90rpx;
  background: #fff;
  border-radius: 6rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: absolute;
  bottom: 0;
  box-shadow: 0 4rpx 8rpx rgba(0,0,0,0.3);
  border: 1rpx solid #eee;
}

.hand-card.selected {
  transform: translateY(-20rpx);
  z-index: 300 !important;
}

.hand-card.disabled { opacity: 0.4; }

/* 结束界面 */
.result-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 500;
}

.result-content { text-align: center; }
.result-icon { font-size: 80rpx; margin-bottom: 10rpx; }
.result-title { font-size: 40rpx; font-weight: bold; color: #fff; }
.result-score { font-size: 32rpx; color: #ffd700; margin-bottom: 30rpx; }
