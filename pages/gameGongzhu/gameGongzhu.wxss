.container {
  width: 100vw;
  height: 100vh;
  background: linear-gradient(180deg, #1a5f1a 0%, #0d3d0d 100%);
  overflow: hidden;
}

/* ========== 1. 准备界面 ========== */
.ready-screen {
  width: 100vw;
  height: 100vh;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 6vw;
  padding: 0 5vw;
  box-sizing: border-box;
}

.ready-box-left-col {
  width: 50vw;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.title-wrap-left {
  display: flex;
  align-items: center;
  gap: 2vw;
  margin-bottom: 3vh;
  max-width: 100%;
}

.emoji-main { font-size: 10vh; line-height: 1; }
.text-title { font-size: 7vh; font-weight: bold; color: #fff; display: block; line-height: 1; }
.text-subtitle { font-size: 2.5vh; color: #ffd700; letter-spacing: 2rpx; display: block; white-space: nowrap; }

.rule-card-white-compact {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 2vh;
  padding: 2vh 3vw;
  box-shadow: 0 1vh 3vh rgba(0, 0, 0, 0.2);
  width: 100%;
  box-sizing: border-box;
}

.rule-row-inline {
  display: flex;
  justify-content: space-between;
  margin-bottom: 1.5vh;
}

.item-rule {
  display: flex;
  align-items: center;
  font-size: 2.2vh;
  color: #333;
}

.suit-s, .suit-d, .suit-h, .suit-c { font-size: 3vh; margin-right: 1vw; width: 3.5vh; text-align: center; }
.suit-d, .suit-h { color: #e53935; }
.val { color: #d4a017; font-weight: bold; margin-left: 1vw; }
.rule-tip-bottom { font-size: 1.8vh; color: #888; text-align: center; border-top: 1rpx solid #eee; padding-top: 1vh; margin-top: 1vh; }

.ready-box-right-btn { width: 30vw; display: flex; justify-content: center; }
.btn-primary-start-large {
  background: linear-gradient(135deg, #ff6b35 0%, #ff8c42 100%);
  color: #fff;
  border-radius: 2vh;
  padding: 3vh 5vw;
  font-size: 3.5vh;
  font-weight: bold;
  box-shadow: 0 1vh 3vh rgba(255, 107, 53, 0.4);
  text-align: center;
}

/* ========== 2. 游戏界面 ========== */
.game-screen-fixed {
  width: 100vw;
  height: 100vh;
  display: flex;
  flex-direction: column;
  position: relative;
}

.bar-top {
  height: 6vh;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 2vw;
}

.tag-status {
  font-size: 2vh;
  color: #fff;
  background: rgba(0,0,0,0.4);
  padding: 0.5vh 2vw;
  border-radius: 1vh;
}

.board-middle { height: 59vh; position: relative; }

.seat-pos {
  position: absolute;
  display: flex;
  align-items: center;
  z-index: 100;
}

/* 玩家位置精准锁定 */
.seat-0 { bottom: 2vh; left: 50%; transform: translateX(-50%); flex-direction: column-reverse; }
.seat-1 { right: 2vw; top: 40%; transform: translateY(-50%); flex-direction: row-reverse; }
.seat-2 { top: 2vh; left: 50%; transform: translateX(-50%); flex-direction: column; }
.seat-3 { left: 2vw; top: 40%; transform: translateY(-50%); flex-direction: row; }

/* 对家和自己的收牌区放右侧，不挡出牌区 */
.seat-2 .u-info, .seat-0 .u-info { flex-direction: row; gap: 1vw; justify-content: center; }
.seat-2 .u-ident-wrap, .seat-0 .u-ident-wrap { position: static; display: flex; gap: 4rpx; }
.seat-2 .u-collected-zone, .seat-0 .u-collected-zone { margin: 0; margin-left: 1vw; max-width: 15vw; }

.u-info {
  background: rgba(0,0,0,0.3);
  border-radius: 1vh;
  padding: 0.8vh 1.5vw;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 2rpx solid transparent;
  min-width: 8vw;
}

.u-active { border-color: #ffd700; box-shadow: 0 0 1.5vh #ffd700; }

.u-avatar {
  width: 5.5vh;
  height: 5.5vh;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 3.5vh;
  position: relative;
}

.u-score { font-size: 2.2vh; font-weight: bold; color: #ffd700; margin-top: 0.3vh; }

.u-ident-wrap { position: absolute; bottom: -1vh; display: flex; gap: 2rpx; z-index: 110; }
.u-ident { font-size: 2.2vh; text-shadow: 0 2rpx 4rpx rgba(0,0,0,0.5); }

.u-collected-zone { display: flex; flex-wrap: wrap; gap: 0.5vw; max-width: 12vw; margin: 1vh; }
.mini-card { font-size: 1.6vh; font-weight: bold; background: #fff; border-radius: 0.3vh; padding: 0.1vh 0.4vw; color: #333; box-shadow: 0 0.2vh 0.5vh rgba(0,0,0,0.3); }
.card-red { color: #e53935; }
.p-red { color: #e53935; }

.center-table-cards {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 30vw;
  height: 25vh;
}

.played-card-box {
  width: 7vh;
  height: 10vh;
  background: #fff;
  border-radius: 0.8vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: absolute;
  box-shadow: 0 0.5vh 1.5vh rgba(0,0,0,0.4);
  border: 1px solid #ddd;
}

.p-suit { font-size: 3.5vh; line-height: 1; }
.p-rank { font-size: 2.5vh; font-weight: bold; color: #333; }

.p-t { top: 0; left: 50%; transform: translateX(-50%); }
.p-b { bottom: 0; left: 50%; transform: translateX(-50%); }
.p-l { left: 0; top: 50%; transform: translateY(-50%); }
.p-r { right: 0; top: 50%; transform: translateY(-50%); }

/* 底部区域 */
.area-bottom-hand {
  height: 35vh;
  background: rgba(0,0,0,0.25);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: flex-end;
  padding-bottom: 2vh;
}

.btn-row-action { height: 7vh; display: flex; align-items: center; margin-bottom: 1vh; }
.btn-confirm-play {
  width: 20vw;
  height: 6.5vh;
  background: #666;
  border-radius: 3vh;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 3vh;
  font-weight: bold;
}

.btn-enabled { background: linear-gradient(135deg, #ffd700 0%, #ffaa00 100%); color: #333; }

.hand-view-center { width: 100vw; height: 22vh; position: relative; }
.hand-card-stack { width: 100%; height: 100%; position: relative; }

.h-card-item {
  width: 8.5vh;
  height: 12.5vh;
  background: #fff;
  border-radius: 0.8vh;
  position: absolute;
  bottom: 3vh;
  box-shadow: 0 0.5vh 1.5vh rgba(0,0,0,0.4);
  border: 1px solid #ccc;
  box-sizing: border-box;
  transition: transform 0.1s;
}

.h-card-face { width: 100%; height: 100%; position: relative; padding: 0.8vh 0.8vh; }
.h-suit { font-size: 2.8vh; display: block; line-height: 1; }
.h-rank { font-size: 2.8vh; font-weight: bold; color: #1a1a1a; display: block; line-height: 1; margin-top: 0.2vh; }
.h-suit-mini { position: absolute; bottom: 0.8vh; right: 0.8vh; font-size: 2vh; opacity: 0.8; }

.h-selected { transform: translateY(-4vh); z-index: 500 !important; border: 0.4vh solid #ffd700; box-shadow: 0 1vh 2vh rgba(255, 215, 0, 0.5); }
.h-disabled { opacity: 0.5; filter: grayscale(0.5); }

/* 结算列表 - 横屏优化 */
.mask-overlay { 
  position: absolute; 
  top: 0; 
  left: 0; 
  width: 100vw; 
  height: 100vh; 
  background: rgba(0,0,0,0.85); 
  display: flex; 
  align-items: center; 
  justify-content: center; 
  z-index: 1000; 
}
.box-result-list { 
  background: #fff; 
  width: 60vw; 
  max-width: 700rpx;
  border-radius: 2vh; 
  padding: 3vh 4vw; 
  box-shadow: 0 1vh 4vh rgba(0,0,0,0.5); 
  display: flex; 
  flex-direction: column; 
  align-items: center; 
  max-height: 80vh;
  overflow-y: auto;
}
.result-header { text-align: center; margin-bottom: 2vh; }
.res-title { font-size: 4vh; font-weight: bold; color: #333; display: block; }
.res-subtitle { font-size: 2.2vh; color: #999; display: block; margin-top: 1vh; }

.score-table { width: 100%; margin-bottom: 3vh; }
.score-row { display: flex; justify-content: space-between; padding: 1.5vh 2vw; border-bottom: 1rpx solid #eee; font-size: 2.4vh; color: #333; }
.score-row.head { font-weight: bold; color: #999; border-bottom: 2rpx solid #ddd; }
.score-row.me { background: #fffbe6; color: #d4a017; font-weight: bold; }
.score-row.teammate { background: #e6f7ff; color: #1890ff; }
.col-p { flex: 2; }
.col-r { flex: 1; text-align: center; color: #666; }
.col-s { flex: 1; text-align: center; font-weight: bold; }
.col-t { flex: 1; text-align: right; }
.plus { color: #52c41a; }
.minus { color: #f5222d; }

.result-actions { display: flex; gap: 3vw; width: 100%; margin-top: 2vh; }
.btn-res { 
  flex: 1; 
  height: 8vh; 
  min-height: 60rpx;
  border-radius: 4vh; 
  display: flex; 
  align-items: center; 
  justify-content: center; 
  font-size: 3vh; 
  font-weight: bold; 
}
.btn-res.next { background: #ff6b35; color: #fff; }
.btn-res.exit { background: #f5f5f5; color: #666; }
