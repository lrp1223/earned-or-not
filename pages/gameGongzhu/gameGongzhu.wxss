.container {
  width: 100vw;
  height: 100vh;
  background: linear-gradient(180deg, #1a472a 0%, #2d5a27 100%);
}

/* ========== 准备界面 ========== */
.ready-screen {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ready-box {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 60rpx;
}
.game-logo {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.logo-icon {
  font-size: 100rpx;
}
.logo-text {
  font-size: 72rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 4rpx 12rpx rgba(0,0,0,0.3);
}
.logo-tag {
  font-size: 28rpx;
  color: rgba(255,255,255,0.8);
  letter-spacing: 6rpx;
  margin-top: 12rpx;
}
.rules-panel {
  background: rgba(255,255,255,0.95);
  border-radius: 20rpx;
  padding: 28rpx;
  box-shadow: 0 12rpx 40rpx rgba(0,0,0,0.2);
}
.rule-row {
  display: flex;
  gap: 32rpx;
  margin-bottom: 20rpx;
}
.rule-cell {
  display: flex;
  align-items: center;
  gap: 10rpx;
  font-size: 26rpx;
  color: #333;
}
.suit {
  font-size: 30rpx;
}
.suit.red {
  color: #e53935;
}
.score {
  color: #d4a017;
  font-weight: 600;
}
.score.neg {
  color: #e53935;
}
.score.pos {
  color: #4caf50;
}
.rule-tip {
  text-align: center;
  font-size: 22rpx;
  color: #888;
  margin-top: 16rpx;
  padding-top: 12rpx;
  border-top: 1rpx solid rgba(0,0,0,0.08);
}
.btn-start {
  background: linear-gradient(135deg, #ff6b35 0%, #ff8c42 100%);
  color: #fff;
  border-radius: 16rpx;
  padding: 28rpx 60rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(255,107,53,0.4);
}

/* ========== 游戏界面 ========== */
.game-screen {
  width: 100%;
  height: 100%;
  position: relative;
}

/* 顶部 */
.header {
  position: absolute;
  top: 16rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  gap: 16rpx;
  z-index: 100;
}
.info-badge {
  font-size: 22rpx;
  color: #fff;
  background: rgba(0,0,0,0.4);
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
}

/* 玩家 */
.player {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 50;
}
.player.top {
  top: 80rpx;
  left: 50%;
  transform: translateX(-50%);
}
.player.left {
  left: 30rpx;
  top: 50%;
  transform: translateY(-50%);
}
.player.right {
  right: 30rpx;
  top: 50%;
  transform: translateY(-50%);
}
.player.bottom {
  bottom: 280rpx;
  left: 50%;
  transform: translateX(-50%);
}
.player.active .avatar {
  box-shadow: 0 0 20rpx #ffd700;
  border: 4rpx solid #ffd700;
}
.avatar {
  width: 72rpx;
  height: 72rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.3);
}
.p-name {
  font-size: 20rpx;
  color: #fff;
  margin-top: 8rpx;
}
.p-score {
  font-size: 28rpx;
  font-weight: bold;
  color: #ffd700;
  margin-top: 4rpx;
}
.p-team {
  font-size: 18rpx;
  color: #4caf50;
  background: #e8f5e9;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-top: 6rpx;
}
.p-cards {
  font-size: 18rpx;
  color: #ccc;
  background: rgba(0,0,0,0.4);
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
  margin-top: 8rpx;
}

/* 桌面 */
.table {
  position: absolute;
  top: 45%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 300rpx;
  height: 240rpx;
}
.card-out {
  width: 90rpx;
  height: 126rpx;
  background: #fff;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: absolute;
  box-shadow: 0 8rpx 20rpx rgba(0,0,0,0.3);
}
.c-suit {
  font-size: 40rpx;
}
.c-suit.red {
  color: #e53935;
}
.c-rank {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
.card-out.out-top {
  top: 0;
  left: 50%;
  transform: translateX(-50%);
}
.card-out.out-bottom {
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
}
.card-out.out-left {
  left: 0;
  top: 50%;
  transform: translateY(-50%);
}
.card-out.out-right {
  right: 0;
  top: 50%;
  transform: translateY(-50%);
}

/* 手牌区 */
.hand-box {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 240rpx;
  background: rgba(0,0,0,0.25);
  display: flex;
  align-items: center;
  padding: 0 30rpx 40rpx;
}
.hand-cards {
  flex: 1;
  height: 160rpx;
  position: relative;
}
.h-card {
  width: 90rpx;
  height: 126rpx;
  background: #fff;
  border-radius: 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: absolute;
  bottom: 0;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.2);
  transition: transform 0.1s;
}
.h-card.up {
  transform: translateY(-30rpx);
}
.h-card.disabled {
  opacity: 0.5;
}
.hand-btn {
  margin-left: 30rpx;
}
.btn-play {
  width: 120rpx;
  height: 64rpx;
  background: #999;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
}
.btn-play.on {
  background: linear-gradient(135deg, #ffd700 0%, #ffaa00 100%);
  color: #333;
}

/* 结束 */
.game-over {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 200;
}
.over-box {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.over-icon {
  font-size: 120rpx;
  margin-bottom: 20rpx;
}
.over-title {
  font-size: 56rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 16rpx;
}
.over-score {
  font-size: 44rpx;
  color: #ffd700;
  margin-bottom: 40rpx;
}
