.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #1a5f1a 0%, #2d7a2d 100%);
}

/* 准备界面 */
.ready-screen {
  min-height: 100vh;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 30rpx;
  gap: 40rpx;
}
.intro {
  text-align: center;
  max-width: 50%;
}
.intro-icon {
  font-size: 80rpx;
  display: block;
}
.intro-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  display: block;
  margin: 10rpx 0;
}
.intro-subtitle {
  font-size: 28rpx;
  color: #ccc;
  display: block;
  margin-bottom: 10rpx;
}
.intro-rules {
  background: rgba(255,255,255,0.15);
  border-radius: 16rpx;
  padding: 20rpx;
  margin-top: 10rpx;
}
.intro-rules text {
  display: block;
  font-size: 26rpx;
  color: #fff;
  margin: 8rpx 0;
}
.btn-wrapper {
  width: 240rpx;
  height: 70rpx;
  background: linear-gradient(135deg, #4caf50 0%, #81c784 100%);
  border-radius: 35rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(76, 175, 80, 0.4);
}
.btn-start-text {
  color: white;
  font-size: 30rpx;
  font-weight: bold;
}

/* 游戏界面 */
.game-screen {
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  padding: 20rpx;
}

/* 顶部区域 */
.top-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 20rpx 0;
}

/* 中间区域 */
.middle-section {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 20rpx 0;
}

/* 侧边玩家 */
.side-player {
  display: flex;
  flex-direction: column;
  align-items: center;
}

/* 桌面区域 */
.table-area {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  margin: 0 20rpx;
}
.round-info {
  display: flex;
  gap: 20rpx;
  margin-bottom: 20rpx;
}
.round-info text {
  font-size: 26rpx;
  color: #fff;
  background: rgba(0,0,0,0.4);
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
}
.table-cards {
  width: 280rpx;
  height: 280rpx;
  position: relative;
}

/* 打出的牌 */
.played-card {
  width: 80rpx;
  height: 110rpx;
  background: white;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: absolute;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.3);
}
.played-card.bottom {
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
}
.played-card.top {
  top: 0;
  left: 50%;
  transform: translateX(-50%);
}
.played-card.left {
  left: 0;
  top: 50%;
  transform: translateY(-50%);
}
.played-card.right {
  right: 0;
  top: 50%;
  transform: translateY(-50%);
}

/* 底部区域 */
.bottom-section {
  padding: 20rpx 0;
}
.player-info-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
  padding: 0 20rpx;
}
.btn-play-wrapper {
  width: 140rpx;
  height: 70rpx;
  background: linear-gradient(135deg, #ffd700 0%, #ffaa00 100%);
  border-radius: 35rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}
.btn-play-text {
  color: #333;
  font-size: 32rpx;
  font-weight: bold;
}

/* 手牌滚动区 */
.hand-scroll {
  width: 100%;
  height: 160rpx;
  white-space: nowrap;
}
.player-hand {
  display: inline-flex;
  gap: 10rpx;
  padding: 10rpx 20rpx;
}
.hand-card {
  width: 90rpx;
  height: 130rpx;
  background: white;
  border-radius: 12rpx;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.2);
  border: 3rpx solid transparent;
}
.hand-card.selected {
  border-color: #ffd700;
  transform: translateY(-10rpx);
}
.hand-card.disabled {
  opacity: 0.4;
}

/* 牌样式 */
.card-suit {
  font-size: 40rpx;
}
.card-suit.red {
  color: #f44336;
}
.card-rank {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}

/* 玩家头像 */
.player-avatar {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 20rpx;
  border-radius: 16rpx;
  background: rgba(255,255,255,0.1);
}
.player-avatar.active {
  background: rgba(255,215,0,0.3);
  border: 2rpx solid #ffd700;
}
.avatar-icon {
  font-size: 48rpx;
}
.player-name {
  font-size: 24rpx;
  color: #fff;
  margin-top: 4rpx;
}
.player-score {
  font-size: 28rpx;
  font-weight: bold;
  color: #ffd700;
  margin-top: 4rpx;
}

.team-tag {
  font-size: 18rpx;
  color: #4caf50;
  background: #e8f5e9;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  margin-top: 4rpx;
}

/* 牌背 */
.card-back {
  width: 70rpx;
  height: 100rpx;
  background: linear-gradient(135deg, #8b0000 0%, #a52a2a 100%);
  border-radius: 10rpx;
  border: 2rpx solid #fff;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-top: 10rpx;
}
.card-back.small {
  width: 50rpx;
  height: 70rpx;
}
.card-count {
  font-size: 22rpx;
  color: #fff;
}

/* 游戏结束 */
.game-over {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.9);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.over-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}
.over-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 20rpx;
}
.over-score {
  font-size: 36rpx;
  color: #ffd700;
  margin-bottom: 10rpx;
}
.over-rank {
  font-size: 32rpx;
  color: #fff;
  margin-bottom: 40rpx;
}
