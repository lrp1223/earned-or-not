.page-container {
  width: 100vw; height: 100vh;
  background: radial-gradient(circle at center, #2d5a27 0%, #1a472a 100%); /* 径向渐变模拟牌桌光照 */
  overflow: hidden;
  position: relative;
}

/* 背景纹理装饰 - Ace水印 */
.page-container::before {
  content: "♠";
  position: absolute;
  font-size: 40vh;
  color: rgba(255,255,255,0.03);
  bottom: -10vh;
  right: -5vw;
  transform: rotate(-15deg);
  pointer-events: none;
}

/* ========== 1. 准备界面美化 ========== */
.ready-screen { 
  width: 100vw; height: 100vh; 
  display: flex; flex-direction: row; 
  align-items: center; justify-content: center; 
  gap: 8vw; padding: 0 8vw calc(env(safe-area-inset-bottom) + 2vh); 
  box-sizing: border-box;
}

.ready-box-left-col { width: 50vw; display: flex; flex-direction: column; align-items: flex-start; }

.title-wrap-left { 
  display: flex; align-items: center; gap: 3vw; margin-bottom: 4vh;
  animation: fadeInDown 0.8s ease-out;
}

.emoji-main { 
  font-size: 12vh; 
  filter: drop-shadow(0 4px 8px rgba(0,0,0,0.3));
}

.text-title { 
  font-size: 9vh; font-weight: 900; color: #fff; 
  letter-spacing: 4rpx;
  text-shadow: 0 4px 15px rgba(0,0,0,0.5);
}

.text-subtitle { 
  font-size: 2.8vh; color: #ffd700; 
  letter-spacing: 10rpx; font-weight: bold;
  opacity: 0.9;
}

/* 玻璃质感规则卡片 */
.rule-card-white-compact { 
  background: rgba(255, 255, 255, 0.1); /* 半透明背景 */
  backdrop-filter: blur(15px); /* 高斯模糊 */
  border-radius: 3vh; 
  padding: 3vh 4vw; 
  border: 1px solid rgba(255, 255, 255, 0.2); /* 亮色边框 */
  box-shadow: 0 2vh 5vh rgba(0, 0, 0, 0.3); 
  width: 100%; box-sizing: border-box;
  animation: fadeInLeft 1s ease-out;
}

.rule-row-inline { display: flex; justify-content: space-between; margin-bottom: 2vh; }

.item-rule { 
  display: flex; align-items: center; 
  font-size: 2.4vh; color: #fff; /* 改为白色文字 */
  text-shadow: 0 2px 4px rgba(0,0,0,0.3);
}

.suit-s, .suit-d, .suit-h, .suit-c { font-size: 3.5vh; margin-right: 1.5vw; width: 4vh; text-align: center; }
.suit-d, .suit-h { color: #ff4d4f; filter: drop-shadow(0 0 5px rgba(255,77,79,0.3)); }
.suit-s, .suit-c { color: #fff; }

.val { 
  color: #ffd700; font-weight: bold; margin-left: 1.5vw;
  font-family: 'Monaco', monospace;
}

.rule-tip-bottom { 
  font-size: 2vh; color: rgba(255,255,255,0.6); 
  text-align: center; border-top: 1rpx solid rgba(255,255,255,0.1); 
  padding-top: 1.5vh; margin-top: 1.5vh;
}

/* 立体质感开始按钮 */
.ready-box-right-btn { 
  width: 30vw; display: flex; justify-content: center;
  animation: fadeInRight 0.8s ease-out;
}

.btn-primary-start-large { 
  background: linear-gradient(135deg, #ff6b35 0%, #ff4d4f 100%); 
  color: #fff; border-radius: 2.5vh; 
  padding: 3.5vh 6vw; font-size: 4vh; font-weight: 900; 
  box-shadow: 0 1.5vh 0 #c4381d, 0 2vh 4vh rgba(0,0,0,0.4); /* 增加底部厚度感 */
  text-align: center; white-space: nowrap;
  transition: all 0.1s;
  text-shadow: 0 2px 4px rgba(0,0,0,0.2);
  letter-spacing: 4rpx;
}

.btn-primary-start-large:active {
  transform: translateY(0.8vh); /* 点击按下效果 */
  box-shadow: 0 0.7vh 0 #c4381d, 0 1vh 2vh rgba(0,0,0,0.3);
}

/* 动画定义 */
@keyframes fadeInDown {
  from { opacity: 0; transform: translateY(-20px); }
  to { opacity: 1; transform: translateY(0); }
}
@keyframes fadeInLeft {
  from { opacity: 0; transform: translateX(-30px); }
  to { opacity: 1; transform: translateX(0); }
}
@keyframes fadeInRight {
  from { opacity: 0; transform: translateX(30px); }
  to { opacity: 1; transform: translateX(0); }
}

/* ========== 游戏内样式保持 v3.5 逻辑，仅做细节润色 ========== */
.game-screen-fixed { width: 100vw; height: 100vh; position: relative; }
.bar-top { height: 6vh; display: flex; justify-content: center; gap: 2vw; z-index: 200; position: relative; }
.tag-status { font-size: 2vh; color: #fff; background: rgba(255,255,255,0.1); border: 1px solid rgba(255,255,255,0.2); padding: 0.5vh 2vw; border-radius: 1vh; backdrop-filter: blur(5px); }

.u-info { 
  background: rgba(0,0,0,0.4); border-radius: 1.5vh; padding: 1vh 2vw;
  box-shadow: 0 4px 10px rgba(0,0,0,0.3);
}
.u-avatar { border: 2rpx solid rgba(255,255,255,0.3); }
.u-active { border-color: #ffd700; box-shadow: 0 0 2vh #ffd700; }

.h-card-item {
  border-radius: 1vh;
  box-shadow: -2px 4px 10px rgba(0,0,0,0.4); /* 叠加阴影 */
  background: #fff url('data:image/svg+xml;utf8,<svg width="100" height="100" xmlns="http://www.w3.org/2000/svg"><rect width="100" height="100" fill="white"/><rect x="5" y="5" width="90" height="90" rx="5" fill="none" stroke="%23f0f0f0" stroke-width="1"/></svg>');
}
