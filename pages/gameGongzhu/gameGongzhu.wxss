.container {
  width: 100vw;
  height: 100vh;
  background: linear-gradient(180deg, #1a472a 0%, #2d5a27 100%);
}

/* ========== 准备界面 ========== */
.ready-screen {
  width: 100%;
  height: 100%;
  display: flex;
  align-items: center;
  justify-content: center;
}
.ready-content {
  display: flex;
  flex-direction: row;
  align-items: center;
  gap: 60rpx;
  padding: 40rpx;
}

/* Logo区 */
.logo-area {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.logo-emoji {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}
.logo-title {
  font-size: 80rpx;
  font-weight: bold;
  color: #fff;
  text-shadow: 0 4rpx 12rpx rgba(0,0,0,0.3);
}
.logo-subtitle {
  font-size: 32rpx;
  color: rgba(255,255,255,0.8);
  letter-spacing: 8rpx;
  margin-top: 16rpx;
}

/* 规则区 */
.rules-area {
  background: rgba(255,255,255,0.95);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.2);
}
.rule-line {
  display: flex;
  gap: 24rpx;
  margin-bottom: 20rpx;
}
.rule-line:last-child {
  margin-bottom: 0;
}
.rule-tag {
  display: flex;
  align-items: center;
  gap: 12rpx;
  font-size: 28rpx;
  color: #333;
}
.suit {
  font-size: 32rpx;
}
.suit.red {
  color: #e53935;
}
.score {
  color: #d4a017;
  font-weight: 600;
}
.rule-tip {
  text-align: center;
  font-size: 24rpx;
  color: #666;
  margin-top: 24rpx;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(0,0,0,0.1);
}

/* 操作区 */
.action-area {
  display: flex;
  flex-direction: column;
  gap: 24rpx;
}
.btn-primary {
  background: linear-gradient(135deg, #ff6b35 0%, #ff8c42 100%);
  color: #fff;
  border-radius: 16rpx;
  padding: 28rpx 56rpx;
  font-size: 32rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 24rpx rgba(255,107,53,0.4);
  white-space: nowrap;
}

/* ========== 游戏界面 ========== */
.game-screen {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
}

/* 顶部信息栏 - 8% */
.header {
  height: 8%;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 16rpx;
  padding: 10rpx 20rpx 0;
  flex-wrap: wrap;
}
.info-tag {
  font-size: 24rpx;
  color: #fff;
  background: rgba(0,0,0,0.3);
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
}

/* 游戏区 - 55% */
.play-area {
  height: 55%;
  position: relative;
}

/* 玩家座位 */
.seat {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 10;
}
.seat-top {
  top: 2%;
  left: 50%;
  transform: translateX(-50%);
}
.seat-left {
  left: 3%;
  top: 50%;
  transform: translateY(-50%);
}
.seat-right {
  right: 3%;
  top: 50%;
  transform: translateY(-50%);
}
.seat-bottom {
  bottom: 4%;
  left: 50%;
  transform: translateX(-50%);
}

/* 玩家信息 */
.player-info {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255,255,255,0.15);
  border-radius: 16rpx;
  padding: 16rpx 20rpx;
  border: 2rpx solid transparent;
}
.player-info.active {
  background: rgba(255,215,0,0.3);
  border-color: #ffd700;
}
.avatar {
  width: 64rpx;
  height: 64rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}
.name {
  font-size: 20rpx;
  color: #fff;
  margin-top: 8rpx;
}
.score {
  font-size: 28rpx;
  font-weight: bold;
  color: #ffd700;
  margin-top: 4rpx;
}
.team-badge {
  font-size: 18rpx;
  color: #4caf50;
  background: #e8f5e9;
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-top: 8rpx;
}
.card-badge {
  font-size: 20rpx;
  color: #ccc;
  background: rgba(0,0,0,0.4);
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
  margin-top: 12rpx;
}

/* 桌面 */
.table {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 45%;
  height: 55%;
}
.played-card {
  width: 90rpx;
  height: 120rpx;
  background: #fff;
  border-radius: 12rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: absolute;
  box-shadow: 0 8rpx 24rpx rgba(0,0,0,0.3);
}
.played-card .card-suit {
  font-size: 40rpx;
}
.played-card .card-suit.red {
  color: #e53935;
}
.played-card .card-rank {
  font-size: 32rpx;
  font-weight: bold;
  color: #333;
}
.played-card.at-top {
  top: 0;
  left: 50%;
  transform: translateX(-50%);
}
.played-card.at-bottom {
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
}
.played-card.at-left {
  left: 0;
  top: 50%;
  transform: translateY(-50%);
}
.played-card.at-right {
  right: 0;
  top: 50%;
  transform: translateY(-50%);
}

/* 手牌区 - 37% */
.hand-area {
  height: 37%;
  display: flex;
  align-items: center;
  padding: 20rpx 30rpx 60rpx;
  background: rgba(0,0,0,0.2);
}
.hand-scroll {
  flex: 1;
  height: 100%;
}
.hand-list {
  display: inline-flex;
  align-items: center;
  gap: 12rpx;
  height: 100%;
  padding: 10rpx 0;
}
.hand-card {
  width: 100rpx;
  height: 140rpx;
  background: #fff;
  border-radius: 12rpx;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 4rpx solid transparent;
  box-shadow: 0 8rpx 16rpx rgba(0,0,0,0.2);
  flex-shrink: 0;
}
.hand-card.selected {
  border-color: #ffd700;
  transform: translateY(-20rpx);
}
.hand-card.disabled {
  opacity: 0.4;
}
.hand-card .card-suit {
  font-size: 44rpx;
}
.hand-card .card-suit.red {
  color: #e53935;
}
.hand-card .card-rank {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
}

/* 手牌操作 */
.hand-action {
  margin-left: 24rpx;
}
.btn-play {
  width: 140rpx;
  height: 72rpx;
  background: #999;
  border-radius: 36rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
}
.btn-play.active {
  background: linear-gradient(135deg, #ffd700 0%, #ffaa00 100%);
  color: #333;
}

/* ========== 结束界面 ========== */
.overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.result-box {
  display: flex;
  flex-direction: column;
  align-items: center;
}
.result-icon {
  font-size: 120rpx;
  margin-bottom: 24rpx;
}
.result-title {
  font-size: 56rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 16rpx;
}
.result-score {
  font-size: 44rpx;
  color: #ffd700;
  margin-bottom: 48rpx;
}
