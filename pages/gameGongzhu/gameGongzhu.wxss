.container {
  width: 100vw;
  height: 100vh;
  background: linear-gradient(135deg, #1a5f1a 0%, #2d7a2d 100%);
}

/* 准备界面 */
.ready-screen {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 20rpx;
}
.ready-content {
  text-align: center;
}
.ready-title {
  font-size: 80rpx;
  color: #fff;
  display: block;
}
.ready-subtitle {
  font-size: 36rpx;
  color: #ccc;
  display: block;
  margin: 10rpx 0 30rpx;
}
.ready-rules {
  background: rgba(255,255,255,0.15);
  border-radius: 16rpx;
  padding: 20rpx 30rpx;
}
.ready-rules text {
  display: block;
  font-size: 28rpx;
  color: #fff;
  margin: 8rpx 0;
}
.ready-btn {
  margin-top: 40rpx;
  width: 240rpx;
  height: 80rpx;
  background: linear-gradient(135deg, #4caf50, #81c784);
  border-radius: 40rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
}

/* 游戏界面 */
.game-screen {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
}

/* 顶部栏 */
.top-bar {
  height: 50rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 20rpx;
  background: rgba(0,0,0,0.2);
}
.top-bar text {
  font-size: 24rpx;
  color: #fff;
  background: rgba(0,0,0,0.3);
  padding: 6rpx 16rpx;
  border-radius: 12rpx;
}

/* 游戏区 */
.game-area {
  flex: 1;
  position: relative;
  display: flex;
  align-items: center;
  justify-content: center;
}

/* 玩家标签 */
.player-tag {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 10rpx 20rpx;
  background: rgba(255,255,255,0.1);
  border-radius: 12rpx;
}
.player-tag.active {
  background: rgba(255,215,0,0.3);
  border: 2rpx solid #ffd700;
}
.player-tag text {
  font-size: 22rpx;
  color: #fff;
}
.player-tag .score {
  font-size: 28rpx;
  font-weight: bold;
  color: #ffd700;
}
.player-tag .team-mark {
  font-size: 18rpx;
  color: #4caf50;
  background: #e8f5e9;
  padding: 2rpx 8rpx;
  border-radius: 8rpx;
  margin-top: 4rpx;
}

/* 对家 */
.player-top {
  position: absolute;
  top: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.player-top .card-num {
  font-size: 20rpx;
  color: #ccc;
  margin-top: 8rpx;
}

/* 左右家 */
.player-left {
  position: absolute;
  left: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.player-right {
  position: absolute;
  right: 20rpx;
  top: 50%;
  transform: translateY(-50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.player-left .card-num, .player-right .card-num {
  font-size: 20rpx;
  color: #ccc;
  margin-top: 8rpx;
}

/* 桌面 */
.table {
  width: 360rpx;
  height: 200rpx;
  position: relative;
}
.table-card-wrap {
  width: 100%;
  height: 100%;
  position: relative;
}
.table-card {
  width: 80rpx;
  height: 110rpx;
  background: #fff;
  border-radius: 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: absolute;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.3);
}
.table-card .suit {
  font-size: 36rpx;
}
.table-card .suit.red {
  color: #f44336;
}
.table-card .rank {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}
.table-card.pos-top {
  top: 0;
  left: 50%;
  transform: translateX(-50%);
}
.table-card.pos-bottom {
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
}
.table-card.pos-left {
  left: 0;
  top: 50%;
  transform: translateY(-50%);
}
.table-card.pos-right {
  right: 0;
  top: 50%;
  transform: translateY(-50%);
}

/* 底部区域 */
.bottom-area {
  height: 160rpx;
  padding: 10rpx 20rpx;
}
.my-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 20rpx;
}
.play-btn {
  width: 140rpx;
  height: 70rpx;
  background: #ccc;
  border-radius: 35rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 32rpx;
  font-weight: bold;
}
.play-btn.active {
  background: linear-gradient(135deg, #ffd700, #ffaa00);
  color: #333;
}

/* 手牌 */
.hand-scroll {
  width: 100%;
  height: 100rpx;
  white-space: nowrap;
}
.hand {
  display: inline-flex;
  gap: 10rpx;
}
.hand-card {
  width: 70rpx;
  height: 95rpx;
  background: #fff;
  border-radius: 8rpx;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 2rpx solid transparent;
}
.hand-card.selected {
  border-color: #ffd700;
  transform: translateY(-8rpx);
}
.hand-card.disabled {
  opacity: 0.4;
}
.hand-card .suit {
  font-size: 36rpx;
}
.hand-card .suit.red {
  color: #f44336;
}
.hand-card .rank {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

/* 结束界面 */
.over-screen {
  position: absolute;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.9);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
}
.over-icon {
  font-size: 100rpx;
  margin-bottom: 20rpx;
}
.over-title {
  font-size: 56rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 20rpx;
}
.over-score {
  font-size: 40rpx;
  color: #ffd700;
  margin-bottom: 40rpx;
}
