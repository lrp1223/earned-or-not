.container {
  width: 100vw;
  height: 100vh;
  background: linear-gradient(180deg, #1a5f1a 0%, #0d3d0d 100%);
  overflow: hidden;
}

/* ========== 1. 准备界面 ========== */
.ready-screen {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  gap: 60rpx;
  padding: 40rpx;
  box-sizing: border-box;
}

.ready-box-left-col {
  width: 50vw;
  display: flex;
  flex-direction: column;
  align-items: flex-start;
}

.title-wrap-left {
  display: flex;
  align-items: center;
  gap: 20rpx;
  margin-bottom: 30rpx;
}

.emoji-main { font-size: 80rpx; }
.text-title { font-size: 64rpx; font-weight: bold; color: #fff; }
.text-subtitle { font-size: 28rpx; color: #ffd700; letter-spacing: 4rpx; }

.rule-card-white-compact {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 20rpx;
  padding: 24rpx 30rpx;
  box-shadow: 0 12rpx 40rpx rgba(0, 0, 0, 0.2);
  width: 100%;
  box-sizing: border-box;
}

.rule-row-inline {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}

.item-rule {
  display: flex;
  align-items: center;
  font-size: 24rpx;
  color: #333;
}

.suit-s, .suit-d, .suit-h, .suit-c { font-size: 32rpx; margin-right: 12rpx; width: 36rpx; text-align: center; }
.suit-d, .suit-h { color: #e53935; }
.val { color: #d4a017; font-weight: bold; margin-left: 10rpx; }
.rule-tip-bottom { font-size: 22rpx; color: #888; text-align: center; border-top: 1rpx solid #eee; padding-top: 12rpx; margin-top: 12rpx; }

.ready-box-right-btn { width: 30vw; display: flex; justify-content: center; }
.btn-primary-start-large {
  background: linear-gradient(135deg, #ff6b35 0%, #ff8c42 100%);
  color: #fff;
  border-radius: 16rpx;
  padding: 30rpx 60rpx;
  font-size: 36rpx;
  font-weight: bold;
  box-shadow: 0 8rpx 24rpx rgba(255, 107, 53, 0.4);
}

/* ========== 2. 游戏界面 ========== */
.game-screen-fixed {
  width: 100%;
  height: 100%;
  position: relative;
}

.bar-top {
  position: absolute;
  top: 16rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  gap: 16rpx;
  z-index: 100;
}

.tag-status {
  font-size: 22rpx;
  color: #fff;
  background: rgba(0,0,0,0.4);
  padding: 8rpx 18rpx;
  border-radius: 20rpx;
}

.board-middle { height: 100%; width: 100%; position: relative; }

.seat-pos {
  position: absolute;
  display: flex;
  align-items: center;
  z-index: 50;
}

/* 玩家位置精准锁定 */
.seat-0 { bottom: 300rpx; left: 50%; transform: translateX(-50%); flex-direction: column-reverse; }
.seat-1 { right: 30rpx; top: 40%; transform: translateY(-50%); flex-direction: row-reverse; }
.seat-2 { top: 80rpx; left: 50%; transform: translateX(-50%); flex-direction: column; }
.seat-3 { left: 30rpx; top: 40%; transform: translateY(-50%); flex-direction: row; }

.u-info {
  background: rgba(0,0,0,0.3);
  border-radius: 12rpx;
  padding: 10rpx 16rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  border: 2rpx solid transparent;
  min-width: 80rpx;
}

.u-active { border-color: #ffd700; box-shadow: 0 0 15rpx #ffd700; }

.u-avatar {
  width: 64rpx;
  height: 64rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 36rpx;
}

.u-score { font-size: 26rpx; font-weight: bold; color: #ffd700; margin-top: 4rpx; }

.u-ident-wrap { position: absolute; bottom: -15rpx; display: flex; gap: 4rpx; z-index: 60; }
.u-ident { font-size: 24rpx; }

.u-collected-zone { display: flex; flex-wrap: wrap; gap: 4rpx; max-width: 120rpx; margin: 10rpx; }
.mini-card { font-size: 18rpx; font-weight: bold; background: #fff; border-radius: 4rpx; padding: 2rpx 6rpx; color: #333; }
.p-red { color: #e53935; }

.center-table-cards {
  position: absolute;
  top: 42%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 300rpx;
  height: 200rpx;
}

.played-card-box {
  width: 80rpx;
  height: 112rpx;
  background: #fff;
  border-radius: 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: absolute;
  box-shadow: 0 6rpx 16rpx rgba(0,0,0,0.3);
  border: 1rpx solid #ddd;
}

.p-suit { font-size: 36rpx; line-height: 1; }
.p-rank { font-size: 28rpx; font-weight: bold; color: #333; }

.p-t { top: 0; left: 50%; transform: translateX(-50%); }
.p-b { bottom: 0; left: 50%; transform: translateX(-50%); }
.p-l { left: 0; top: 50%; transform: translateY(-50%); }
.p-r { right: 0; top: 50%; transform: translateY(-50%); }

/* 底部区域高度扩展 */
.area-bottom-hand {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 280rpx;
  background: rgba(0,0,0,0.35);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: env(safe-area-inset-bottom);
}

.btn-row-action { height: 100rpx; display: flex; align-items: center; }
.btn-confirm-play {
  width: 160rpx;
  height: 64rpx;
  background: #666;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
}

.btn-enabled { background: linear-gradient(135deg, #ffd700 0%, #ffaa00 100%); color: #333; }

.hand-view-center { width: 100%; height: 160rpx; position: relative; }
.hand-card-stack { width: 100%; height: 100%; position: relative; }

.h-card-item {
  width: 80rpx;
  height: 112rpx;
  background: #fff;
  border-radius: 8rpx;
  position: absolute;
  bottom: 20rpx;
  box-shadow: -2rpx 4rpx 10rpx rgba(0,0,0,0.3);
  border: 1rpx solid #ccc;
  box-sizing: border-box;
}

.h-card-face { width: 100%; height: 100%; position: relative; padding: 8rpx; box-sizing: border-box; }
.h-suit { font-size: 26rpx; display: block; line-height: 1; }
.h-rank { font-size: 26rpx; font-weight: bold; color: #1a1a1a; display: block; line-height: 1; margin-top: 4rpx; }
.h-suit-mini { position: absolute; bottom: 8rpx; right: 8rpx; font-size: 20rpx; opacity: 0.8; }

.h-selected { transform: translateY(-40rpx); z-index: 500 !important; border: 3rpx solid #ffd700; box-shadow: 0 5rpx 15rpx rgba(255,215,0,0.4); }
.h-disabled { opacity: 0.5; }

/* 结算列表 */
.mask-overlay { position: absolute; top: 0; left: 0; width: 100vw; height: 100vh; background: rgba(0,0,0,0.85); display: flex; align-items: center; justify-content: center; z-index: 1000; }
.box-result-list { background: #fff; width: 500rpx; border-radius: 20rpx; padding: 30rpx; box-shadow: 0 10rpx 40rpx rgba(0,0,0,0.5); display: flex; flex-direction: column; align-items: center; }
.result-header { text-align: center; margin-bottom: 20rpx; }
.res-title { font-size: 36rpx; font-weight: bold; color: #333; display: block; }
.res-subtitle { font-size: 24rpx; color: #999; }

.score-table { width: 100%; margin-bottom: 30rpx; }
.score-row { display: flex; justify-content: space-between; padding: 12rpx 10rpx; border-bottom: 1rpx solid #eee; font-size: 24rpx; color: #333; }
.score-row.head { font-weight: bold; color: #999; }
.score-row.me { background: #fffbe6; color: #d4a017; font-weight: bold; }
.col-p { flex: 2; }
.col-s { flex: 1; text-align: center; }
.col-t { flex: 1; text-align: right; }
.plus { color: #52c41a; }
.minus { color: #f5222d; }

.result-actions { display: flex; gap: 20rpx; width: 100%; }
.btn-res { flex: 1; height: 72rpx; border-radius: 36rpx; display: flex; align-items: center; justify-content: center; font-size: 28rpx; font-weight: bold; }
.btn-res.next { background: #ff6b35; color: #fff; }
.btn-res.exit { background: #f5f5f5; color: #999; }
