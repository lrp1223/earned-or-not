.container {
  width: 100vw;
  height: 100vh;
  background: linear-gradient(180deg, #1a472a 0%, #2d5a27 100%);
  overflow: hidden;
}

/* 准备界面 */
.ready-screen {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  padding: 40rpx;
  box-sizing: border-box;
}

.ready-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-right: 80rpx;
}

.game-title {
  font-size: 80rpx;
  color: #fff;
  font-weight: bold;
  text-shadow: 0 4rpx 12rpx rgba(0,0,0,0.4);
}

.game-subtitle {
  font-size: 32rpx;
  color: rgba(255,255,255,0.85);
  margin-top: 16rpx;
  letter-spacing: 8rpx;
}

.start-btn {
  margin-top: 60rpx;
  background: linear-gradient(135deg, #ff6b35 0%, #ff8c42 100%);
  color: #fff;
  padding: 30rpx 80rpx;
  border-radius: 16rpx;
  font-size: 36rpx;
  font-weight: 600;
  box-shadow: 0 8rpx 32rpx rgba(255,107,53,0.4);
}

.ready-right {
  background: rgba(255,255,255,0.95);
  border-radius: 24rpx;
  padding: 32rpx;
  box-shadow: 0 16rpx 48rpx rgba(0,0,0,0.2);
}

.rule-item {
  display: flex;
  align-items: center;
  padding: 16rpx 0;
  font-size: 28rpx;
  color: #333;
  border-bottom: 1rpx solid rgba(0,0,0,0.06);
}

.rule-item:last-child {
  border-bottom: none;
}

.suit {
  font-size: 36rpx;
  margin-right: 16rpx;
  width: 40rpx;
  text-align: center;
}

.suit.red {
  color: #e53935;
}

.score {
  margin-left: auto;
  color: #d4a017;
  font-weight: 600;
}

/* 游戏界面 */
.game-screen {
  width: 100%;
  height: 100%;
  position: relative;
}

/* 顶部信息 */
.header {
  position: absolute;
  top: 10rpx;
  left: 0;
  right: 0;
  display: flex;
  justify-content: center;
  gap: 10rpx;
  z-index: 200;
}

.info-tag {
  font-size: 20rpx;
  color: #fff;
  background: rgba(0,0,0,0.4);
  padding: 6rpx 16rpx;
  border-radius: 20rpx;
}

/* 玩家座位 - 关键：层级调高 */
.player-seat {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  z-index: 150; 
}

.seat-top {
  top: 60rpx;
  left: 50%;
  transform: translateX(-50%);
}

.seat-left {
  left: 20rpx;
  top: 40%;
  transform: translateY(-50%);
}

.seat-right {
  right: 20rpx;
  top: 40%;
  transform: translateY(-50%);
}

.seat-bottom {
  bottom: 220rpx;
  left: 50%;
  transform: translateX(-50%);
}

.avatar-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255,255,255,0.2);
  border-radius: 12rpx;
  padding: 8rpx 16rpx;
  border: 2rpx solid transparent;
}

.avatar-box.active {
  background: rgba(255,215,0,0.4);
  border-color: #ffd700;
}

.avatar {
  width: 50rpx;
  height: 50rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 30rpx;
}

.player-name { font-size: 18rpx; color: #fff; margin-top: 4rpx; }
.player-score { font-size: 24rpx; font-weight: bold; color: #ffd700; }
.team-badge { font-size: 16rpx; color: #4caf50; background: #e8f5e9; padding: 2rpx 8rpx; border-radius: 6rpx; margin-top: 4rpx; }
.card-count { font-size: 18rpx; color: #ccc; background: rgba(0,0,0,0.4); padding: 4rpx 12rpx; border-radius: 10rpx; margin-top: 6rpx; }

/* 桌面 - 关键：层级调低 */
.table-area {
  position: absolute;
  top: 40%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 240rpx;
  height: 200rpx;
  z-index: 10;
}

.played-card {
  width: 70rpx;
  height: 100rpx;
  background: #fff;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: absolute;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.3);
}

.card-suit { font-size: 32rpx; }
.card-suit.red { color: #e53935; }
.card-rank { font-size: 24rpx; font-weight: bold; color: #333; }

.pos-top { top: 0; left: 50%; transform: translateX(-50%); }
.pos-bottom { bottom: 0; left: 50%; transform: translateX(-50%); }
.pos-left { left: 0; top: 50%; transform: translateY(-50%); }
.pos-right { right: 0; top: 50%; transform: translateY(-50%); }

/* 手牌区域 */
.hand-section {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  height: 180rpx;
  background: rgba(0,0,0,0.4);
  display: flex;
  flex-direction: column;
  align-items: center;
  padding-bottom: env(safe-area-inset-bottom);
  z-index: 250;
}

.play-btn-area {
  margin-bottom: 10rpx;
}

.play-btn {
  width: 140rpx;
  height: 56rpx;
  background: #888;
  border-radius: 28rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 28rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.2);
}

.play-btn.active {
  background: linear-gradient(135deg, #ffd700 0%, #ffaa00 100%);
  color: #333;
}

.hand-container {
  width: 650rpx; /* 增加宽度 */
  height: 100rpx;
  position: relative;
  display: flex;
  justify-content: center;
}

.hand-card {
  width: 70rpx;
  height: 100rpx;
  background: #fff;
  border-radius: 8rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: absolute;
  bottom: 0;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.3);
  border: 1rpx solid #eee;
}

.hand-card.selected {
  border-color: #ffd700;
  transform: translateY(-20rpx);
  z-index: 300 !important;
}

.hand-card.disabled {
  opacity: 0.4;
}

/* 结束界面 */
.result-overlay {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.9);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 500;
}

.result-content {
  display: flex;
  flex-direction: column;
  align-items: center;
}

.result-icon { font-size: 100rpx; margin-bottom: 20rpx; }
.result-title { font-size: 48rpx; font-weight: bold; color: #fff; margin-bottom: 16rpx; }
.result-score { font-size: 36rpx; color: #ffd700; margin-bottom: 40rpx; }
