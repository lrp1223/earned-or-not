.container {
  width: 100vw;
  height: 100vh;
  background: linear-gradient(180deg, #1a5f1a 0%, #0d3d0d 100%);
}

/* 准备界面 - 横屏左右布局 */
.ready-screen {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: row;
  align-items: center;
  justify-content: center;
  background: linear-gradient(180deg, #1a472a 0%, #2d5a27 100%);
  padding: 40rpx;
  box-sizing: border-box;
  gap: 40rpx;
}

/* 左侧：标题和按钮 */
.ready-left {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 35%;
}

/* 标题区 */
.title-section {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin-bottom: 60rpx;
}
.game-emoji {
  font-size: 80rpx;
  margin-bottom: 16rpx;
}
.game-title {
  font-size: 72rpx;
  font-weight: 700;
  color: #fff;
  text-shadow: 0 4rpx 16rpx rgba(0,0,0,0.3);
}
.game-subtitle {
  font-size: 32rpx;
  color: rgba(255,255,255,0.85);
  letter-spacing: 8rpx;
  margin-top: 16rpx;
}

/* 开始按钮 */
.start-btn {
  background: linear-gradient(135deg, #ff6b35 0%, #ff8c42 100%);
  color: #fff;
  border-radius: 16rpx;
  padding: 28rpx 80rpx;
  font-size: 36rpx;
  font-weight: 600;
  letter-spacing: 4rpx;
  box-shadow: 0 8rpx 32rpx rgba(255, 107, 53, 0.4);
}
.start-btn:active {
  transform: scale(0.98);
  box-shadow: 0 4rpx 16rpx rgba(255, 107, 53, 0.3);
}

/* 右侧：规则 */
.ready-right {
  width: 55%;
  max-width: 600rpx;
}

/* 规则卡片 */
.rule-card {
  background: rgba(255, 255, 255, 0.95);
  border-radius: 24rpx;
  padding: 30rpx;
  box-shadow: 0 16rpx 64rpx rgba(0, 0, 0, 0.25);
}
.rule-row {
  display: flex;
  justify-content: space-between;
  margin-bottom: 16rpx;
}
.rule-item {
  display: flex;
  align-items: center;
  flex: 1;
  padding: 12rpx 8rpx;
  font-size: 26rpx;
  color: #333;
}
.rule-note {
  text-align: center;
  font-size: 24rpx;
  color: #666;
  padding-top: 16rpx;
  border-top: 1rpx solid rgba(0,0,0,0.08);
  margin-top: 8rpx;
}
.suit {
  font-size: 32rpx;
  margin-right: 12rpx;
  width: 36rpx;
  text-align: center;
}
.suit.spade, .suit.club {
  color: #1a1a1a;
}
.suit.heart, .suit.diamond {
  color: #e53935;
}
.rule-text {
  flex: 1;
}
.score-highlight {
  color: #d4a017;
  font-weight: 600;
  font-size: 26rpx;
  margin-left: 8rpx;
}

/* 游戏界面 */
.game-screen {
  width: 100%;
  height: 100%;
  position: relative;
}

/* 顶部信息 */
.top-info {
  position: absolute;
  top: 10rpx;
  left: 50%;
  transform: translateX(-50%);
  display: flex;
  gap: 16rpx;
  z-index: 10;
}
.top-info text {
  font-size: 22rpx;
  color: #fff;
  background: rgba(0,0,0,0.4);
  padding: 8rpx 16rpx;
  border-radius: 16rpx;
}

/* 玩家通用 */
.player {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
}
.avatar-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(255,255,255,0.15);
  border-radius: 12rpx;
  padding: 10rpx 16rpx;
  border: 2rpx solid transparent;
}
.avatar-box.active {
  background: rgba(255,215,0,0.3);
  border-color: #ffd700;
}
.avatar {
  width: 56rpx;
  height: 56rpx;
  background: #fff;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 32rpx;
}
.name {
  font-size: 18rpx;
  color: #fff;
  margin-top: 4rpx;
}
.score {
  font-size: 26rpx;
  font-weight: bold;
  color: #ffd700;
  margin-top: 2rpx;
}
.team-tag {
  font-size: 16rpx;
  color: #4caf50;
  background: #e8f5e9;
  padding: 2rpx 8rpx;
  border-radius: 6rpx;
  margin-top: 4rpx;
}
.card-count {
  font-size: 18rpx;
  color: #ccc;
  margin-top: 6rpx;
  background: rgba(0,0,0,0.3);
  padding: 4rpx 12rpx;
  border-radius: 10rpx;
}

/* 对家 */
.player-top {
  top: 80rpx;
  left: 50%;
  transform: translateX(-50%);
  z-index: 20;
}

/* 左右家 */
.player-left {
  left: 10rpx;
  top: 45%;
  transform: translateY(-50%);
  z-index: 20;
}
.player-right {
  right: 10rpx;
  top: 45%;
  transform: translateY(-50%);
  z-index: 20;
}

/* 桌面 */
.table-area {
  position: absolute;
  top: 42%;
  left: 50%;
  transform: translate(-50%, -50%);
  width: 45vw;
  height: 32vw;
  max-width: 360rpx;
  max-height: 250rpx;
  z-index: 10;
}
.table-cards {
  width: 100%;
  height: 100%;
  position: relative;
}
.card-played {
  width: 18vw;
  height: 25vw;
  max-width: 90rpx;
  max-height: 120rpx;
  background: #fff;
  border-radius: 10rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: absolute;
  box-shadow: 0 6rpx 18rpx rgba(0,0,0,0.3);
}
.card-played .suit {
  font-size: 32rpx;
}
.card-played .suit.red {
  color: #f44336;
}
.card-played .rank {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
}
.card-played.pos-top {
  top: 0;
  left: 50%;
  transform: translateX(-50%);
}
.card-played.pos-bottom {
  bottom: 0;
  left: 50%;
  transform: translateX(-50%);
}
.card-played.pos-left {
  left: 0;
  top: 50%;
  transform: translateY(-50%);
}
.card-played.pos-right {
  right: 0;
  top: 50%;
  transform: translateY(-50%);
}

/* 自己 */
.player-self {
  position: absolute;
  bottom: 0;
  left: 0;
  right: 0;
  padding: 10rpx 20rpx 30rpx;
  background: rgba(0,0,0,0.3);
  z-index: 30;
}
.self-info {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 15rpx;
}
.play-btn {
  width: 140rpx;
  height: 64rpx;
  background: #999;
  border-radius: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 30rpx;
  font-weight: bold;
  margin-right: 20rpx;
}
.play-btn.active {
  background: linear-gradient(180deg, #ffd700 0%, #ffaa00 100%);
  color: #333;
}

/* 手牌 */
.hand-scroll {
  width: 100%;
  height: 130rpx;
  white-space: nowrap;
}
.hand {
  display: inline-flex;
  gap: 8rpx;
  padding: 5rpx 0;
}
.hand-card {
  width: 18vw;
  height: 25vw;
  max-width: 85rpx;
  max-height: 115rpx;
  background: #fff;
  border-radius: 10rpx;
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  border: 3rpx solid transparent;
  box-shadow: 0 4rpx 10rpx rgba(0,0,0,0.2);
}
.hand-card.selected {
  border-color: #ffd700;
  transform: translateY(-10rpx);
}
.hand-card.disabled {
  opacity: 0.4;
}
.hand-card .suit {
  font-size: 34rpx;
}
.hand-card .suit.red {
  color: #f44336;
}
.hand-card .rank {
  font-size: 26rpx;
  font-weight: bold;
  color: #333;
}

/* 结束界面 */
.over-screen {
  position: absolute;
  top: 0;
  left: 0;
  right: 0;
  bottom: 0;
  background: rgba(0,0,0,0.9);
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 100;
}
.over-icon {
  font-size: 120rpx;
  margin-bottom: 30rpx;
}
.over-title {
  font-size: 60rpx;
  font-weight: bold;
  color: #fff;
  margin-bottom: 20rpx;
}
.over-score {
  font-size: 48rpx;
  color: #ffd700;
  margin-bottom: 60rpx;
}
