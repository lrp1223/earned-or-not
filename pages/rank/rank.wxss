/**pages/rank/rank.wxss**/
/* 类型切换：软色胶囊，选中态浅底 + 主色描边 */
.tab-bar { display: flex; padding: 8rpx 0 20rpx; }
.tab-item { font-size: 26rpx; padding: 12rpx 28rpx; border-radius: 32rpx; background: #fff; color: #666; border: 1rpx solid var(--card-border); margin-right: 16rpx; }
.tab-item.active { background: var(--primary-tint); color: var(--primary); border-color: #f3c3c3; font-weight: 600; }

.rank-list { margin-top: 8rpx; }
.rank-item { display: flex; justify-content: space-between; align-items: center; padding: 24rpx; background: #fff; border: 1rpx solid var(--card-border); border-radius: var(--radius); margin-bottom: 18rpx; }
.rank-item.rank-me { border: 2rpx solid var(--primary); background: var(--primary-tint); }

.rank-left { display: flex; align-items: center; flex: 1; height: 64rpx; }
.rank-number { width: 52rpx; height: 52rpx; border-radius: 50%; background: #f1f1f1; color: #999; font-size: 26rpx; font-weight: bold; display: flex; align-items: center; justify-content: center; margin-right: 20rpx; flex-shrink: 0; font-variant-numeric: tabular-nums; }
.rank-number.g { background: linear-gradient(135deg, #ffd76e, #f5a623); color: #7a4a00; }
.rank-number.s { background: linear-gradient(135deg, #e8eaee, #b9bfc9); color: #4a5058; }
.rank-number.b { background: linear-gradient(135deg, #f0b27a, #c97b3d); color: #5c2e00; }

.rank-avatar { width: 64rpx; height: 64rpx; border-radius: 50%; margin-right: 16rpx; flex-shrink: 0; vertical-align: middle; }
.rank-avatar-default { width: 64rpx; height: 64rpx; border-radius: 50%; background: #2b2b2b; color: white; font-size: 28rpx; display: flex; align-items: center; justify-content: center; margin-right: 16rpx; flex-shrink: 0; }

.rank-name { font-size: 30rpx; color: #333; line-height: 64rpx; vertical-align: middle; }
.rank-name-me { font-weight: bold; color: var(--primary); }
.rank-tag { margin-left: 12rpx; padding: 4rpx 14rpx; background: var(--primary); color: white; font-size: 20rpx; border-radius: 10rpx; vertical-align: middle; }

.rank-right { margin-left: 20rpx; }
.rank-amount { font-size: 36rpx; font-weight: bold; font-variant-numeric: tabular-nums; }

.empty-state { display: flex; flex-direction: column; align-items: center; padding: 100rpx 40rpx; }
.empty-icon { font-size: 80rpx; margin-bottom: 20rpx; }
.empty-text { font-size: 32rpx; color: #333; margin-bottom: 12rpx; }
.empty-hint { font-size: 26rpx; color: #999; }

.load-more, .no-more { text-align: center; padding: 40rpx; font-size: 28rpx; color: #999; }
.load-more:active { color: var(--primary); }
