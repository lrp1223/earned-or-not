<!--pages/climbGame/climbGame.wxml-->
<view class="container">
  <view class="header">
    <text class="title">🏔️ 幸运登山赛</text>
    <text class="subtitle">爬得越高，奖金越多！随时可兑现</text>
  </view>

  <!-- 山峰 -->
  <view class="mountain">
    <view class="level {{index === currentLevel ? 'current' : ''}} {{index < currentLevel ? 'passed' : ''}}" 
          wx:for="{{levels}}" 
          wx:key="index"
          style="left: {{item.x}}%; bottom: {{item.y}}%;">
      <view class="level-dot">{{index + 1}}</view>
      <view class="level-prize" wx:if="{{item.prize}}">{{item.prize}}</view>
    </view>
    <!-- 当前位置标记 -->
    <view class="player" style="left: {{levels[currentLevel].x}}%; bottom: {{levels[currentLevel].y}}%;">🏃</view>
  </view>

  <!-- 当前奖金 -->
  <view class="prize-box">
    <text class="prize-label">当前奖金</text>
    <text class="prize-value">{{currentPrize}}元</text>
    <text class="prize-hint" wx:if="{{nextPrize}}">再上一级可得 {{nextPrize}}元</text>
  </view>

  <!-- 游戏控制 -->
  <view class="control-area" wx:if="{{!gameOver}}">
    <view class="dice-result" wx:if="{{diceResult}}">
      <text class="dice-label">刮开结果</text>
      <text class="dice-value">{{diceResult}}</text>
    </view>
    
    <view class="scratch-area" wx:if="{{!diceResult}}">
      <text class="scratch-hint">刮开决定你的命运</text>
      <view class="scratch-cards">
        <view class="scratch-card {{item.scratched ? 'scratched' : ''}}" 
              wx:for="{{scratchCards}}" 
              wx:key="index"
              bindtap="scratchCard"
              data-index="{{index}}">
          <text wx:if="{{item.scratched}}">{{item.value}}</text>
          <text wx:else class="scratch-text">?</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 按钮 -->
  <view class="actions" wx:if="{{!gameOver}}">
    <button class="btn-cash" bindtap="cashOut" disabled="{{currentLevel === 0}}">💰 兑现拿走</button>
    <button class="btn-climb" bindtap="climbUp" disabled="{{!canClimb}}">🏔️ 继续攀登</button>
  </view>

  <!-- 游戏结束 -->
  <view class="game-over" wx:if="{{gameOver}}">
    <text class="over-icon">{{win ? '🎉' : '😅'}}</text>
    <text class="over-title">{{win ? '登顶成功！' : '选择兑现'}}</text>
    <text class="over-prize">获得 {{finalPrize}}元</text>
    <button class="btn-restart" bindtap="newGame">再来一局</button>
  </view>
</view>
