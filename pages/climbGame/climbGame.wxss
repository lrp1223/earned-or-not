.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #e6f7ff 0%, #f0f9ff 50%, #fff 100%);
  padding: 30rpx;
}
.header {
  text-align: center;
  padding: 30rpx 0;
}
.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #1890ff;
  display: block;
}
.subtitle {
  font-size: 26rpx;
  color: #666;
  margin-top: 10rpx;
  display: block;
}

/* 山峰 */
.mountain {
  height: 400rpx;
  position: relative;
  margin: 40rpx 0;
  background: linear-gradient(180deg, #52c41a 0%, #95de64 100%);
  border-radius: 20rpx;
  overflow: hidden;
}
.level {
  position: absolute;
  transform: translate(-50%, 50%);
  display: flex;
  flex-direction: column;
  align-items: center;
}
.level-dot {
  width: 60rpx;
  height: 60rpx;
  background: white;
  border-radius: 50%;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  font-weight: bold;
  color: #666;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.2);
}
.level.current .level-dot {
  background: #ff6b6b;
  color: white;
  animation: pulse 1s infinite;
}
.level.passed .level-dot {
  background: #52c41a;
  color: white;
}
@keyframes pulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.1); }
}
.level-prize {
  font-size: 24rpx;
  color: #fff;
  background: rgba(0,0,0,0.3);
  padding: 4rpx 12rpx;
  border-radius: 8rpx;
  margin-top: 8rpx;
}
.player {
  position: absolute;
  font-size: 48rpx;
  transform: translate(-50%, -100%);
  transition: all 0.5s ease;
}

/* 奖金显示 */
.prize-box {
  background: white;
  border-radius: 24rpx;
  padding: 40rpx;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.08);
  margin: 30rpx 0;
}
.prize-label {
  font-size: 28rpx;
  color: #999;
  display: block;
}
.prize-value {
  font-size: 72rpx;
  font-weight: bold;
  color: #ff6b6b;
  display: block;
  margin: 20rpx 0;
}
.prize-hint {
  font-size: 24rpx;
  color: #52c41a;
}

/* 控制区 */
.control-area {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin: 30rpx 0;
  text-align: center;
}
.dice-result {
  padding: 40rpx;
}
.dice-label {
  font-size: 28rpx;
  color: #999;
  display: block;
}
.dice-value {
  font-size: 80rpx;
  display: block;
  margin-top: 20rpx;
}
.dice-value.up {
  color: #52c41a;
}
.dice-value.down {
  color: #ff4d4f;
}

/* 刮卡区 */
.scratch-hint {
  font-size: 28rpx;
  color: #666;
  margin-bottom: 20rpx;
  display: block;
}
.scratch-cards {
  display: flex;
  justify-content: center;
  gap: 20rpx;
}
.scratch-card {
  width: 140rpx;
  height: 180rpx;
  background: linear-gradient(135deg, #ffd700 0%, #ffaa00 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 170, 0, 0.3);
}
.scratch-card.scratched {
  background: white;
  border: 4rpx solid #52c41a;
}
.scratch-card.scratched.down {
  border-color: #ff4d4f;
}
.scratch-text {
  font-size: 48rpx;
  color: #8b4513;
  font-weight: bold;
}

/* 按钮 */
.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}
.actions button {
  flex: 1;
  height: 100rpx;
  line-height: 100rpx;
  border-radius: 50rpx;
  font-size: 32rpx;
  border: none;
  font-weight: bold;
}
.btn-cash {
  background: #f5f5f5;
  color: #666;
}
.btn-cash:not([disabled]) {
  background: linear-gradient(135deg, #52c41a 0%, #95de64 100%);
  color: white;
}
.btn-climb {
  background: #f5f5f5;
  color: #999;
}
.btn-climb:not([disabled]) {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  color: white;
}

/* 游戏结束 */
.game-over {
  background: white;
  border-radius: 24rpx;
  padding: 60rpx;
  text-align: center;
  box-shadow: 0 12rpx 48rpx rgba(0,0,0,0.1);
}
.over-icon {
  font-size: 80rpx;
  display: block;
}
.over-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin: 20rpx 0;
}
.over-prize {
  font-size: 48rpx;
  font-weight: bold;
  color: #ff6b6b;
  display: block;
  margin-bottom: 40rpx;
}
.btn-restart {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  color: white;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  border: none;
}
