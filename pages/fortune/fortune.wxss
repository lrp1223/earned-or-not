/**pages/fortune/fortune.wxss**/
.container { padding: 20rpx; }

.header { text-align: center; padding: 40rpx; }
.date { font-size: 32rpx; color: #666; display: block; }
.constellation { font-size: 48rpx; font-weight: bold; color: #ff6b6b; margin-top: 16rpx; display: block; }

.fortune-card { background: linear-gradient(135deg, #ff6b6b, #ff8e8e); border-radius: 24rpx; padding: 60rpx 40rpx; margin: 20rpx; text-align: center; color: white; }
.fortune-title { font-size: 36rpx; font-weight: bold; margin-bottom: 30rpx; }
.stars { margin-bottom: 20rpx; }
.star { font-size: 48rpx; opacity: 0.3; margin: 0 8rpx; }
.star.active { opacity: 1; }
.fortune-score { font-size: 72rpx; font-weight: bold; margin-bottom: 20rpx; }
.fortune-text { font-size: 32rpx; opacity: 0.9; }

.detail-card { background: white; border-radius: 24rpx; padding: 40rpx; margin: 20rpx; }
.detail-row { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.detail-row:last-child { border-bottom: none; }
.detail-label { font-size: 30rpx; color: #666; }
.detail-value { font-size: 30rpx; font-weight: bold; }
.detail-value.good { color: #52c41a; }
.detail-value.bad { color: #ff4d4f; }
.detail-value.luck { color: #1890ff; }

.tips { text-align: center; padding: 40rpx; font-size: 26rpx; color: #999; }