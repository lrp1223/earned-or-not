/* pages/fortune/fortune.wxss */
.container {
  background: linear-gradient(180deg, #fff5f5 0%, #ffffff 100%);
  min-height: 100vh;
  padding: 20rpx;
}

/* 头部 */
.header {
  text-align: center;
  padding: 20rpx 0 10rpx;
}
.date {
  font-size: 24rpx;
  color: #999;
  display: block;
}
.constellation {
  font-size: 40rpx;
  font-weight: bold;
  color: #ff6b6b;
  display: block;
}

/* 运势卡片 */
.fortune-card {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  border-radius: 24rpx;
  padding: 30rpx;
  margin: 10rpx 0;
  text-align: center;
  box-shadow: 0 12rpx 40rpx rgba(255, 107, 107, 0.3);
}
.fortune-title {
  font-size: 26rpx;
  color: rgba(255,255,255,0.9);
  margin-bottom: 16rpx;
}
.stars {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.star {
  font-size: 36rpx;
  opacity: 0.3;
}
.star.active {
  opacity: 1;
}
.fortune-score {
  font-size: 56rpx;
  font-weight: bold;
  color: white;
  margin-bottom: 12rpx;
}
.fortune-text {
  font-size: 26rpx;
  color: rgba(255,255,255,0.95);
  padding: 12rpx 24rpx;
  background: rgba(255,255,255,0.15);
  border-radius: 12rpx;
  display: inline-block;
}

/* 宜忌卡片 */
.yiji-card {
  display: flex;
  gap: 16rpx;
  margin: 16rpx 0;
}
.yiji-item {
  flex: 1;
  background: white;
  border-radius: 20rpx;
  padding: 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}
.yiji-icon {
  font-size: 32rpx;
  margin-bottom: 8rpx;
}
.yiji-label {
  font-size: 22rpx;
  color: #999;
  display: block;
  margin-bottom: 6rpx;
}
.yiji-value {
  font-size: 28rpx;
  font-weight: bold;
}
.yiji-item.good .yiji-value {
  color: #52c41a;
}
.yiji-item.bad .yiji-value {
  color: #ff4d4f;
}

/* 幸运信息 - 横向排列 */
.lucky-info-row {
  display: flex;
  gap: 16rpx;
  margin: 16rpx 0;
}
.lucky-info-item {
  flex: 1;
  background: white;
  border-radius: 20rpx;
  padding: 20rpx;
  text-align: center;
  box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.06);
}
.lucky-info-icon {
  font-size: 36rpx;
  margin-bottom: 6rpx;
}
.lucky-info-label {
  font-size: 20rpx;
  color: #999;
  display: block;
  margin-bottom: 4rpx;
}
.lucky-info-value {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
}

/* 幸运号码 */
.lottery-numbers {
  background: white;
  border-radius: 24rpx;
  padding: 30rpx;
  margin: 16rpx 0;
  text-align: center;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.08);
}
.lottery-type {
  font-size: 28rpx;
  font-weight: bold;
  color: #333;
  margin-bottom: 24rpx;
}
.lottery-balls {
  display: flex;
  justify-content: center;
  gap: 12rpx;
  margin-bottom: 16rpx;
}
.blue-row {
  margin-top: 8rpx;
}
.red-ball, .blue-ball {
  width: 64rpx;
  height: 64rpx;
  line-height: 64rpx;
  border-radius: 50%;
  font-size: 28rpx;
  font-weight: bold;
  color: white;
}
.red-ball {
  background: linear-gradient(135deg, #ff4d4f 0%, #ff7875 100%);
  box-shadow: 0 4rpx 12rpx rgba(255, 77, 79, 0.4);
}
.blue-ball {
  background: linear-gradient(135deg, #1890ff 0%, #69c0ff 100%);
  box-shadow: 0 4rpx 12rpx rgba(24, 144, 255, 0.4);
}

/* 提示 */
.tips {
  text-align: center;
  padding: 20rpx;
  font-size: 22rpx;
  color: #999;
}
