.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f0f9ff 0%, #ffffff 100%);
  padding: 30rpx;
}
.header {
  text-align: center;
  padding: 30rpx 0;
}
.title {
  font-size: 44rpx;
  font-weight: bold;
  color: #333;
  display: block;
}
.subtitle {
  font-size: 26rpx;
  color: #999;
  margin-top: 10rpx;
  display: block;
}

/* 牌面 */
.cards-area {
  display: flex;
  justify-content: center;
  gap: 20rpx;
  margin: 40rpx 0;
}
.card {
  width: 120rpx;
  height: 160rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  font-weight: bold;
  color: white;
  box-shadow: 0 12rpx 32rpx rgba(255, 107, 107, 0.3);
}

/* 输入框 */
.input-box {
  background: white;
  border-radius: 20rpx;
  padding: 30rpx;
  margin: 30rpx 0;
  text-align: center;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
  min-height: 120rpx;
}
.input-text {
  font-size: 40rpx;
  color: #333;
  word-break: break-all;
}
.result {
  font-size: 48rpx;
  font-weight: bold;
  color: #ff6b6b;
  margin-top: 20rpx;
  display: block;
}

/* 键盘 */
.keypad {
  margin: 30rpx 0;
}
.key-row {
  display: flex;
  justify-content: center;
  gap: 16rpx;
  margin-bottom: 16rpx;
}
.key {
  width: 140rpx;
  height: 100rpx;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 40rpx;
  font-weight: bold;
  box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.1);
}
.key.num {
  background: linear-gradient(135deg, #e6f7ff 0%, #bae7ff 100%);
  color: #1890ff;
}
.key.num.used {
  background: #f5f5f5;
  color: #999;
  opacity: 0.6;
}
.key.op {
  background: linear-gradient(135deg, #fff7e6 0%, #ffe7ba 100%);
  color: #fa8c16;
}
.key.clear {
  background: #f5f5f5;
  color: #666;
  font-size: 28rpx;
}
.key.check {
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  color: white;
}
.key:active {
  transform: scale(0.95);
}

/* 按钮 */
.actions {
  display: flex;
  gap: 20rpx;
  margin-top: 40rpx;
}
.actions button {
  flex: 1;
  height: 88rpx;
  line-height: 88rpx;
  border-radius: 44rpx;
  font-size: 30rpx;
  border: none;
}
.btn-hint {
  background: #fff7e6;
  color: #fa8c16;
}
.btn-new {
  background: #f6ffed;
  color: #52c41a;
}

/* 提示 */
.hint-box {
  background: #fffbe6;
  border: 2rpx solid #ffe58f;
  border-radius: 16rpx;
  padding: 30rpx;
  margin-top: 30rpx;
  text-align: center;
}
.hint-title {
  font-size: 28rpx;
  color: #d48806;
  display: block;
  margin-bottom: 16rpx;
}
.hint-text {
  font-size: 32rpx;
  color: #333;
  font-weight: bold;
}
