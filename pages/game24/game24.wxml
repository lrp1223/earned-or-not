<!--pages/game24/game24.wxml-->
<view class="container">
  <view class="header">
    <text class="title">🃏 二十四点</text>
    <text class="subtitle">用 + - × ÷ 让4个数等于24</text>
  </view>

  <!-- 牌面 -->
  <view class="cards-area">
    <view class="card" wx:for="{{cards}}" wx:key="index">{{item}}</view>
  </view>

  <!-- 输入显示 -->
  <view class="input-box">
    <text class="input-text">{{expression || '点击数字和符号'}}</text>
    <text class="result" wx:if="{{result !== null}}">= {{result}}</text>
  </view>

  <!-- 键盘 -->
  <view class="keypad">
    <view class="key-row">
      <view class="key num {{usedCards[0] ? 'used' : ''}}" data-index="0" bindtap="inputNum">{{cards[0]}}</view>
      <view class="key num {{usedCards[1] ? 'used' : ''}}" data-index="1" bindtap="inputNum">{{cards[1]}}</view>
      <view class="key num {{usedCards[2] ? 'used' : ''}}" data-index="2" bindtap="inputNum">{{cards[2]}}</view>
      <view class="key num {{usedCards[3] ? 'used' : ''}}" data-index="3" bindtap="inputNum">{{cards[3]}}</view>
    </view>
    <view class="key-row">
      <view class="key op" data-op="+" bindtap="inputOp">+</view>
      <view class="key op" data-op="-" bindtap="inputOp">-</view>
      <view class="key op" data-op="*" bindtap="inputOp">×</view>
      <view class="key op" data-op="/" bindtap="inputOp">÷</view>
    </view>
    <view class="key-row">
      <view class="key op" data-op="(" bindtap="inputOp">(</view>
      <view class="key op" data-op=")" bindtap="inputOp">)</view>
      <view class="key backspace" bindtap="backspace">⌫</view>
      <view class="key clear" bindtap="clear">C</view>
    </view>
    <view class="key-row">
      <view class="key check" bindtap="check" style="width: 100%;">验证</view>
    </view>
  </view>

  <!-- 按钮 -->
  <view class="actions">
    <button class="btn-hint" bindtap="toggleHint">💡 提示</button>
    <button class="btn-new" bindtap="newGame">🔄 换一题</button>
  </view>

  <!-- 提示 -->
  <view class="hint-box" wx:if="{{showHint}}">
    <text class="hint-title">💡 参考答案</text>
    <text class="hint-text">{{hint}}</text>
  </view>
</view>
