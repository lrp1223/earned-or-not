/* pages/gameGongzhuOnline/gameGongzhuOnline.wxss */

.container {
  width: 100vw;
  height: 100vh;
  background: linear-gradient(180deg, #1a5f1a 0%, #0d3d0d 100%);
  overflow: hidden;
}

/* ========== 1. 首页入口 ========== */
.home-screen {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  gap: 8vh;
}

.title-box {
  display: flex;
  align-items: center;
  gap: 3vw;
}

.emoji-main { font-size: 15vh; }
.text-title { font-size: 10vh; font-weight: bold; color: #fff; display: block; }
.text-subtitle { font-size: 3vh; color: #ffd700; display: block; }

.btn-group { display: flex; flex-direction: column; gap: 3vh; width: 60vw; }
.btn-primary, .btn-secondary {
  height: 8vh;
  border-radius: 4vh;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 3.5vh;
  font-weight: bold;
}
.btn-primary { background: linear-gradient(135deg, #ff6b35 0%, #ff8c42 100%); color: #fff; }
.btn-secondary { background: rgba(255,255,255,0.9); color: #1a5f1a; }

/* 弹窗 */
.modal-overlay {
  position: fixed;
  top: 0; left: 0;
  width: 100vw; height: 100vh;
  background: rgba(0,0,0,0.7);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}
.modal-box {
  background: #fff;
  border-radius: 3vh;
  padding: 4vh;
  width: 70vw;
}
.modal-title { font-size: 3.5vh; font-weight: bold; color: #333; display: block; text-align: center; margin-bottom: 3vh; }
.room-input {
  width: 100%;
  height: 6vh;
  border: 2rpx solid #ddd;
  border-radius: 1vh;
  padding: 0 2vw;
  font-size: 3vh;
  text-align: center;
  box-sizing: border-box;
}
.modal-btns { display: flex; gap: 3vw; margin-top: 3vh; }
.btn-cancel, .btn-confirm { flex: 1; height: 6vh; border-radius: 3vh; display: flex; align-items: center; justify-content: center; font-size: 2.8vh; }
.btn-cancel { background: #f5f5f5; color: #666; }
.btn-confirm { background: #ff6b35; color: #fff; }

/* ========== 2. 等待大厅 ========== */
.lobby-screen {
  width: 100%;
  height: 100%;
  padding: 4vh 4vw;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.lobby-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 3vh;
}
.room-id { font-size: 3.5vh; font-weight: bold; color: #ffd700; }
.room-status { font-size: 2.8vh; color: #fff; background: rgba(0,0,0,0.3); padding: 0.8vh 1.5vw; border-radius: 1vh; }

.player-list { 
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 2.5vh 2vw;
  flex: 1;
}
.player-slot {
  background: rgba(255,255,255,0.95);
  border-radius: 2vh;
  padding: 2.5vh 1.5vw;
  display: flex;
  flex-direction: column;
  align-items: center;
  box-sizing: border-box;
}
.player-slot.empty { background: rgba(255,255,255,0.3); border: 2rpx dashed rgba(255,255,255,0.5); }
.player-avatar { width: 7vh; height: 7vh; border-radius: 50%; }
.player-avatar-placeholder { font-size: 5vh; color: #999; }
.player-name { font-size: 2.3vh; color: #333; margin-top: 1vh; text-align: center; }
.player-tag { font-size: 1.6vh; color: #fff; background: #ff6b35; padding: 0.4vh 0.8vw; border-radius: 1vh; margin-top: 1vh; }
.player-tag.ai { background: #1890ff; }

.lobby-actions { 
  display: grid;
  grid-template-columns: repeat(2, 1fr);
  gap: 2vh;
  margin-top: 3vh;
}
.btn-add-ai, .btn-start-game, .btn-leave {
  height: 6.5vh;
  border-radius: 3.5vh;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 2.8vh;
  font-weight: bold;
}
.btn-add-ai { background: #1890ff; color: #fff; }
.btn-start-game { background: #52c41a; color: #fff; }
.btn-start-game.disabled { background: #999; }
.btn-leave { background: rgba(255,255,255,0.9); color: #333; }

/* ========== 3. 游戏界面 ========== */
.game-screen {
  width: 100%;
  height: 100%;
  display: flex;
  flex-direction: column;
}

.game-header {
  height: 5vh;
  display: flex;
  justify-content: center;
  align-items: center;
  gap: 3vw;
}
.round-info { font-size: 2.3vh; color: #fff; background: rgba(0,0,0,0.3); padding: 0.6vh 1.5vw; border-radius: 1vh; }
.countdown { font-size: 2.3vh; color: #ff4d4f; background: rgba(255,77,79,0.2); padding: 0.6vh 1.5vw; border-radius: 1vh; font-weight: bold; }

.game-board { flex: 1; position: relative; }

/* 玩家座位 */
.player-seat {
  position: absolute;
  display: flex;
  flex-direction: column;
  align-items: center;
  background: rgba(0,0,0,0.3);
  padding: 1vh 1.5vw;
  border-radius: 1.5vh;
  border: 2rpx solid transparent;
  transition: all 0.3s;
}
.player-seat.active { border-color: #ffd700; box-shadow: 0 0 2vh #ffd700; }
.seat-top { top: 2vh; left: 50%; transform: translateX(-50%); }
.seat-left { left: 2vw; top: 50%; transform: translateY(-50%); }
.seat-right { right: 2vw; top: 50%; transform: translateY(-50%); }
.seat-bottom { bottom: 2vh; left: 50%; transform: translateX(-50%); }
.seat-avatar { width: 6vh; height: 6vh; border-radius: 50%; }
.seat-name { font-size: 2vh; color: #fff; margin-top: 0.5vh; }
.seat-score { font-size: 2.2vh; color: #ffd700; font-weight: bold; }

/* 桌面出牌 */
.table-cards { position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 35vw; height: 25vh; }
.table-card {
  width: 7vh; height: 10vh;
  background: #fff;
  border-radius: 1vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: absolute;
  box-shadow: 0 0.5vh 1.5vh rgba(0,0,0,0.4);
}
.card-suit { font-size: 3.5vh; }
.card-suit.red { color: #e53935; }
.card-rank { font-size: 2.5vh; font-weight: bold; color: #333; }
.pos-top { top: 0; left: 50%; transform: translateX(-50%); }
.pos-bottom { bottom: 0; left: 50%; transform: translateX(-50%); }
.pos-left { left: 0; top: 50%; transform: translateY(-50%); }
.pos-right { right: 0; top: 50%; transform: translateY(-50%); }

/* AI 思考提示 */
.ai-thinking {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(0, 0, 0, 0.7);
  padding: 2vh 3vw;
  border-radius: 2vh;
  z-index: 100;
}
.thinking-dots {
  font-size: 3vh;
  color: #fff;
  animation: pulse 1s infinite;
}
@keyframes pulse {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

/* 一轮结束提示 */
.round-result {
  position: absolute;
  top: 50%;
  left: 50%;
  transform: translate(-50%, -50%);
  background: rgba(255, 215, 0, 0.95);
  padding: 2vh 3vw;
  border-radius: 2vh;
  z-index: 100;
  animation: popIn 0.3s ease-out;
}
.winner-name {
  font-size: 3.5vh;
  color: #333;
  font-weight: bold;
}
@keyframes popIn {
  0% { transform: translate(-50%, -50%) scale(0.5); opacity: 0; }
  100% { transform: translate(-50%, -50%) scale(1); opacity: 1; }
}

/* 底部手牌 */
.hand-area {
  height: 22vh;
  background: rgba(0,0,0,0.25);
  display: flex;
  align-items: center;
  padding: 0 3vw;
  gap: 2vw;
}
.hand-cards { flex: 1; display: flex; align-items: center; justify-content: center; gap: 0.8vw; }
.hand-card {
  width: 7vh; height: 10.5vh;
  background: #fff;
  border-radius: 0.8vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-shadow: 0 0.5vh 1.5vh rgba(0,0,0,0.4);
  transition: transform 0.1s;
}
.hand-card.selected { transform: translateY(-2.5vh); border: 0.4vh solid #ffd700; }
.hand-card.disabled { opacity: 0.5; filter: grayscale(0.5); }
.btn-play {
  width: 10vw; height: 10vh;
  background: #666;
  border-radius: 2vh;
  display: flex;
  align-items: center;
  justify-content: center;
  color: #fff;
  font-size: 2.5vh;
  font-weight: bold;
  flex-shrink: 0;
}
.btn-play.enabled { background: linear-gradient(135deg, #ffd700 0%, #ffaa00 100%); color: #333; }

/* ========== 4. 结算界面 ========== */
.result-overlay {
  position: fixed;
  top: 0; left: 0;
  width: 100vw; height: 100vh;
  background: rgba(0,0,0,0.85);
  display: flex;
  align-items: center;
  justify-content: center;
  z-index: 1000;
}
.result-box {
  background: #fff;
  border-radius: 2vh;
  padding: 4vh;
  width: 70vw;
}
.result-title { font-size: 4vh; font-weight: bold; color: #333; display: block; text-align: center; margin-bottom: 3vh; }
.result-list { margin-bottom: 3vh; }
.result-item {
  display: flex;
  align-items: center;
  padding: 1.5vh 2vw;
  border-bottom: 1rpx solid #eee;
  font-size: 2.5vh;
}
.result-item.me { background: #fffbe6; }
.result-rank { width: 6vw; font-size: 3vh; }
.result-avatar { width: 5vh; height: 5vh; border-radius: 50%; margin-right: 2vw; }
.result-name { flex: 1; }
.result-score { width: 10vw; text-align: center; }
.result-total { width: 10vw; text-align: right; font-weight: bold; }
.result-actions { display: flex; gap: 3vw; }
.btn-again, .btn-exit { flex: 1; height: 6vh; border-radius: 3vh; display: flex; align-items: center; justify-content: center; font-size: 2.8vh; font-weight: bold; }
.btn-again { background: #ff6b35; color: #fff; }
.btn-exit { background: #f5f5f5; color: #666; }