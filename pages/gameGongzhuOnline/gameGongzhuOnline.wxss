/* ========== 2. 等待大厅（全新设计 - 适配各种屏幕） ========== */
.lobby-screen {
  width: 100%;
  height: 100%;
  padding: 2vh 4vw;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
  background: linear-gradient(180deg, #1a5f1a 0%, #0d3d0d 100%);
}

/* 顶部房间信息 */
.lobby-header {
  display: flex;
  align-items: center;
  justify-content: center;
  gap: 2vw;
  margin-bottom: 2vh;
  padding: 1vh 0;
}
.room-label { 
  font-size: 2vh; 
  color: rgba(255,255,255,0.6);
}
.room-id { 
  font-size: 4vh; 
  font-weight: bold; 
  color: #ffd700;
  letter-spacing: 0.5vw;
  font-family: monospace;
}

/* 玩家区域 - Flex布局更稳定 */
.player-list { 
  display: flex;
  flex-wrap: wrap;
  justify-content: center;
  gap: 2vh 3vw;
  flex: 1;
  align-content: center;
  padding: 1vh 0;
}

/* 玩家卡片 - 固定宽高比 */
.player-slot {
  width: 38vw;
  height: 18vh;
  background: linear-gradient(145deg, #fff 0%, #f5f5f5 100%);
  border-radius: 1.5vh;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  box-sizing: border-box;
  box-shadow: 0 4px 15px rgba(0,0,0,0.15);
  position: relative;
}

/* 空位样式 */
.player-slot.empty { 
  background: rgba(255,255,255,0.08);
  border: 2rpx dashed rgba(255,255,255,0.3);
  box-shadow: none;
}

/* 头像区域 */
.player-avatar { 
  width: 6vh;
  height: 6vh;
  border-radius: 50%;
  border: 2rpx solid #ddd;
  background: #fff;
}

/* 空位头像 */
.player-avatar-placeholder { 
  width: 6vh;
  height: 6vh;
  border-radius: 50%;
  background: rgba(255,255,255,0.15);
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 3vh;
  color: rgba(255,255,255,0.5);
  border: 2rpx dashed rgba(255,255,255,0.3);
}

/* 玩家名 */
.player-name { 
  font-size: 1.8vh; 
  color: #333; 
  margin-top: 1vh;
  font-weight: 500;
  max-width: 90%;
  overflow: hidden;
  text-overflow: ellipsis;
  white-space: nowrap;
}
.player-slot.empty .player-name {
  color: rgba(255,255,255,0.5);
}

/* 标签 */
.player-tag { 
  font-size: 1.2vh; 
  color: #fff; 
  padding: 0.3vh 1vw;
  border-radius: 0.6vh;
  margin-top: 0.8vh;
  position: absolute;
  top: 0.5vh;
  right: 1vw;
}
.player-tag:not(.ai) { 
  background: #ff6b35;
}
.player-tag.ai { 
  background: #1890ff;
}

/* 底部按钮区域 */
.lobby-actions { 
  display: flex;
  flex-direction: column;
  gap: 1.5vh;
  padding: 2vh 0;
}

/* 按钮样式 */
.btn-add-ai, .btn-start-game, .btn-leave {
  width: 100%;
  height: 5.5vh;
  border-radius: 2.75vh;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 2.2vh;
  font-weight: bold;
}

.btn-add-ai { 
  background: #1890ff;
  color: #fff;
}
.btn-add-ai.disabled {
  background: #666;
  opacity: 0.5;
}

.btn-start-game { 
  background: #52c41a;
  color: #fff;
}
.btn-start-game.disabled { 
  background: #666;
  opacity: 0.5;
}

.btn-leave { 
  background: rgba(255,255,255,0.9);
  color: #333;
}