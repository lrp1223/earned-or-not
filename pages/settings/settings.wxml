<!--pages/settings/settings.wxml-->
<view class="container">
  <!-- 生日设置 -->
  <view class="settings-card">
    <view class="section-title">🎂 生日设置</view>
    <view class="birthday-content">
      <picker mode="date" value="{{birthday}}" bindchange="onBirthdayChange" end="{{today}}">
        <view class="birthday-picker">
          <view class="birthday-display {{birthday ? '' : 'placeholder'}}">
            <text class="birthday-date">{{birthday || '请选择出生日期'}}</text>
            <text class="birthday-constellation" wx:if="{{constellation}}">{{constellation}}</text>
          </view>
          <text class="birthday-arrow">›</text>
        </view>
      </picker>
      <text class="birthday-hint" wx:if="{{!constellation}}">设置生日可查看每日运势</text>
    </view>
  </view>
  
  <!-- 赢色设置 -->
  <view class="settings-card">
    <view class="section-title">赢色设置</view>
    <view class="color-grid">
      <view class="color-item {{winColor === item.value ? 'active' : ''}}" 
            wx:for="{{colorOptions}}" 
            wx:key="value"
            bindtap="selectWinColor"
            data-color="{{item.value}}">
        <view class="color-circle" style="background: {{item.value}}"></view>
        <text class="color-name">{{item.name}}</text>
      </view>
    </view>
  </view>
  
  <!-- 亏色设置 -->
  <view class="settings-card">
    <view class="section-title">亏色设置</view>
    <view class="color-grid">
      <view class="color-item {{loseColor === item.value ? 'active' : ''}}" 
            wx:for="{{colorOptions}}" 
            wx:key="value"
            bindtap="selectLoseColor"
            data-color="{{item.value}}">
        <view class="color-circle" style="background: {{item.value}}"></view>
        <text class="color-name">{{item.name}}</text>
      </view>
    </view>
  </view>
  
  <!-- 预览 -->
  <view class="preview-card">
    <view class="section-title">效果预览</view>
    <view class="preview-item">
      <text class="preview-label">盈利示例</text>
      <text class="preview-win" style="color: {{winColor}}">+100.00元</text>
    </view>
    <view class="preview-item">
      <text class="preview-label">亏损示例</text>
      <text class="preview-lose" style="color: {{loseColor}}">-50.00元</text>
    </view>
  </view>
  
  <!-- 提示 -->
  <view class="tips">点击颜色即可保存，返回后生效</view>
</view>