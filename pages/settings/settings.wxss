/**pages/settings/settings.wxss**/
.container { padding: 20rpx; }

.settings-card { padding: 40rpx; margin: 20rpx; background: white; border-radius: 24rpx; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08); }
.section-title { font-size: 32rpx; font-weight: bold; color: #333; margin-bottom: 30rpx; display: flex; align-items: center; }
.section-title::before { content: "🎨"; margin-right: 12rpx; }

.color-grid { display: flex; flex-wrap: wrap; gap: 30rpx; }
.color-item { display: flex; flex-direction: column; align-items: center; padding: 20rpx; border-radius: 16rpx; border: 2rpx solid transparent; transition: all 0.3s; }
.color-item.active { border-color: #ff6b6b; background: #fff5f5; }
.color-circle { width: 80rpx; height: 80rpx; border-radius: 50%; margin-bottom: 12rpx; box-shadow: 0 4rpx 12rpx rgba(0,0,0,0.15); }
.color-name { font-size: 24rpx; color: #666; }
.color-item.active .color-name { color: #ff6b6b; font-weight: bold; }

.preview-card { padding: 40rpx; margin: 20rpx; background: white; border-radius: 24rpx; box-shadow: 0 4rpx 20rpx rgba(0,0,0,0.08); }
.preview-item { display: flex; justify-content: space-between; align-items: center; padding: 24rpx 0; border-bottom: 1rpx solid #f0f0f0; }
.preview-item:last-child { border-bottom: none; }
.preview-label { font-size: 30rpx; color: #666; }
.preview-win { font-size: 36rpx; font-weight: bold; }
.preview-lose { font-size: 36rpx; font-weight: bold; }

.tips { text-align: center; padding: 30rpx; font-size: 26rpx; color: #999; }

/* 生日设置 */
.birthday-content { padding: 10rpx 0; }
.birthday-picker { display: flex; align-items: center; background: #f8f8f8; border-radius: 16rpx; padding: 30rpx; }
.birthday-display { flex: 1; display: flex; align-items: center; }
.birthday-date { font-size: 34rpx; color: #333; font-weight: 500; }
.birthday-display.placeholder .birthday-date { color: #999; }
.birthday-constellation { margin-left: 20rpx; padding: 8rpx 20rpx; background: linear-gradient(135deg, #ff6b6b, #ff8e8e); color: white; border-radius: 20rpx; font-size: 26rpx; font-weight: bold; }
.birthday-arrow { font-size: 40rpx; color: #ccc; margin-left: 20rpx; }
.birthday-hint { font-size: 26rpx; color: #999; margin-top: 16rpx; display: block; padding-left: 10rpx; }