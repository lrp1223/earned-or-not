<!--pages/gameScratch/gameScratch.wxml-->
<view class="container">
  <view class="header">
    <text class="title">🎲 手气测试</text>
    <text class="subtitle">9张牌选3张，满20就中奖！</text>
  </view>

  <!-- 进度 -->
  <view class="progress-box">
    <text class="progress-text">已选 {{selectedCount}}/3 张</text>
    <view class="progress-bar">
      <view class="progress-fill" style="width: {{selectedCount * 33.33}}%"></view>
    </view>
  </view>

  <!-- 9张牌 3×3 -->
  <view class="cards-grid">
    <view class="num-card {{item.scratched ? 'scratched' : ''}} {{item.animating ? 'animating' : ''}}" 
          wx:for="{{cards}}" 
          wx:key="index"
          bindtap="scratchCard"
          data-index="{{index}}">
      <text class="card-num" wx:if="{{item.scratched}}">{{item.value}}</text>
      <text class="card-mask" wx:else>?</text>
    </view>
  </view>

  <!-- 当前总分 -->
  <view class="score-box">
    <text class="score-label">当前总分</text>
    <text class="score-value {{score >= 20 ? 'win' : score >= 15 ? 'close' : ''}}">{{score}}</text>
    <text class="score-target">/ 20</text>
  </view>

  <!-- 结果 -->
  <view class="result-box" wx:if="{{result}}">
    <text class="result-icon">{{result.icon}}</text>
    <text class="result-text">{{result.text}}</text>
    <text class="result-sub">{{result.sub}}</text>
  </view>

  <!-- 按钮 -->
  <view class="actions">
    <button class="btn-play" bindtap="newGame" wx:if="{{gameOver}}">{{result.retryText}}</button>
  </view>

  <!-- 统计 -->
  <view class="stats">
    <text>今日已玩 {{playCount}} 次</text>
    <text wx:if="{{winCount > 0}}">，中奖 {{winCount}} 次 🎉</text>
  </view>
</view>
