.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #fff5f5 0%, #ffffff 100%);
  padding: 40rpx;
}
.header {
  text-align: center;
  padding: 30rpx 0;
}
.title {
  font-size: 52rpx;
  font-weight: bold;
  color: #ff6b6b;
  display: block;
}
.subtitle {
  font-size: 28rpx;
  color: #999;
  margin-top: 16rpx;
  display: block;
}

/* 进度条 */
.progress-box {
  margin: 30rpx 0;
}
.progress-text {
  font-size: 28rpx;
  color: #666;
  text-align: center;
  display: block;
  margin-bottom: 16rpx;
}
.progress-bar {
  height: 16rpx;
  background: #f0f0f0;
  border-radius: 8rpx;
  overflow: hidden;
}
.progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #ff6b6b, #ff8e8e);
  border-radius: 8rpx;
  transition: width 0.3s;
}

/* 9张牌网格 */
.cards-grid {
  display: grid;
  grid-template-columns: repeat(3, 1fr);
  gap: 20rpx;
  margin: 40rpx 0;
}
.num-card {
  aspect-ratio: 1;
  background: linear-gradient(135deg, #ffd700 0%, #ffaa00 100%);
  border-radius: 20rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 8rpx 24rpx rgba(255, 170, 0, 0.3);
}
.num-card.scratched {
  background: white;
  border: 4rpx solid #ff6b6b;
}
.num-card.animating {
  animation: shake 0.3s ease;
}
@keyframes shake {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(0.95); }
}
.card-mask {
  font-size: 60rpx;
  color: #8b4513;
  font-weight: bold;
}
.card-num {
  font-size: 56rpx;
  font-weight: bold;
  color: #ff6b6b;
}

/* 分数 */
.score-box {
  text-align: center;
  margin: 40rpx 0;
}
.score-label {
  font-size: 28rpx;
  color: #999;
  display: block;
}
.score-value {
  font-size: 80rpx;
  font-weight: bold;
  color: #333;
  display: inline;
}
.score-value.close {
  color: #fa8c16;
}
.score-value.win {
  color: #52c41a;
}
.score-target {
  font-size: 40rpx;
  color: #999;
}

/* 结果 */
.result-box {
  text-align: center;
  margin: 40rpx 0;
  padding: 30rpx;
  background: white;
  border-radius: 20rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.08);
}
.result-icon {
  font-size: 80rpx;
  display: block;
}
.result-text {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-top: 20rpx;
}
.result-sub {
  font-size: 28rpx;
  color: #ff6b6b;
  display: block;
  margin-top: 16rpx;
}

/* 按钮 */
.actions {
  margin-top: 40rpx;
}
.btn-play {
  width: 100%;
  height: 100rpx;
  line-height: 100rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  color: white;
  font-size: 36rpx;
  font-weight: bold;
  border-radius: 50rpx;
  border: none;
  box-shadow: 0 12rpx 40rpx rgba(255, 107, 107, 0.4);
}

/* 统计 */
.stats {
  text-align: center;
  margin-top: 60rpx;
  font-size: 26rpx;
  color: #bbb;
}
