<!--pages/record-list/record-list.wxml-->
<view class="container">
  <view class="header">
    <text class="title">{{typeText}}记录</text>
    <text class="subtitle">共 {{total}} 条</text>
  </view>
  
  <view class="record-list">
    <view class="record-item" wx:for="{{records}}" wx:key="_id">
      <view class="record-left">
        <text class="record-icon">{{type === 'lottery' ? '🎰' : type === 'scratch' ? '🎫' : '🀄'}}</text>
        <view class="record-info">
          <text class="record-type">{{item.lotteryType || typeText}}</text>
          <text class="record-date">{{item.timeStr}}</text>
          <text class="record-remark" wx:if="{{item.remark}}">{{item.remark}}</text>
        </view>
      </view>
      <view class="record-right">
        <text class="record-amount {{item.net >= 0 ? 'win' : 'lose'}}">
          {{item.net >= 0 ? '+' : ''}}{{item.netStr}}元
        </text>
        <text class="record-detail" wx:if="{{item.cost !== undefined}}">
          花{{item.cost}}中{{item.winAmount || 0}}
        </text>
        <text class="record-detail" wx:if="{{item.amount !== undefined}}">
          {{item.amount >= 0 ? '赢' : '输'}}{{Math.abs(item.amount)}}元
        </text>
      </view>
    </view>
  </view>
  
  <!-- 加载更多 -->
  <view class="load-more" wx:if="{{hasMore}}" bindtap="loadMore">
    <text>点击加载更多</text>
  </view>
  <view class="no-more" wx:if="{{!hasMore && records.length > 0}}">
    <text>没有更多了</text>
  </view>
  
  <!-- 空状态 -->
  <view class="empty" wx:if="{{records.length === 0}}">
    <text class="empty-icon">📭</text>
    <text class="empty-text">暂无记录</text>
  </view>
</view>