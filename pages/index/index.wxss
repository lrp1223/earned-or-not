/**pages/index/index.wxss**/
/* 问候头区：无卡片，直接铺在页面底色上 */
.greet { padding: 20rpx 10rpx 12rpx; }
.greet-user { display: flex; align-items: center; }
.greet-avatar { width: 88rpx; height: 88rpx; border-radius: 50%; margin-right: 20rpx; flex-shrink: 0; }
.greet-avatar-fallback { background: #2b2b2b; color: #fff; display: flex; align-items: center; justify-content: center; font-size: 32rpx; font-weight: bold; }
.greet-name { font-size: 34rpx; font-weight: bold; color: #222; }
.greet-date { font-size: 22rpx; color: #999; margin-top: 4rpx; }
.greet-label { font-size: 22rpx; color: #888; margin-top: 40rpx; }
.greet-num { font-size: 72rpx; font-weight: bold; margin-top: 6rpx; line-height: 1.15; font-variant-numeric: tabular-nums; }
.greet-unit { font-size: 26rpx; font-weight: normal; margin-left: 8rpx; }

.title { display: flex; justify-content: space-between; align-items: center; margin-bottom: 12rpx; }
.subtitle { font-size: 26rpx; color: var(--primary); }

/* 快捷记账：浅色底纹圆角块 */
.quick-actions { display: flex; justify-content: space-around; margin-top: 16rpx; }
.action-item { display: flex; flex-direction: column; align-items: center; padding: 12rpx; font-size: 24rpx; color: #555; }
.action-icon { width: 100rpx; height: 100rpx; border-radius: 34rpx; display: flex; align-items: center; justify-content: center; font-size: 48rpx; margin-bottom: 10rpx; }
.action-icon.lottery { background: var(--primary-tint); }
.action-icon.scratch { background: #e4f6f3; }
.action-icon.mahjong { background: #fdf3dc; }

/* 最近记录：去底色，细线分隔 */
.record-item { display: flex; align-items: center; padding: 22rpx 0; border-bottom: 1rpx solid #f4f4f4; }
.record-item:last-child { border-bottom: none; padding-bottom: 4rpx; }
.record-icon { width: 76rpx; height: 76rpx; border-radius: 26rpx; display: flex; align-items: center; justify-content: center; font-size: 38rpx; margin-right: 20rpx; flex-shrink: 0; }
.record-icon.lottery { background: var(--primary-tint); }
.record-icon.scratch { background: #e4f6f3; }
.record-icon.mahjong { background: #fdf3dc; }
.record-info { flex: 1; }
.record-top { display: flex; justify-content: space-between; align-items: center; margin-bottom: 6rpx; }
.record-type { font-size: 30rpx; font-weight: 600; color: #333; }
.record-amount { font-size: 34rpx; font-weight: bold; font-variant-numeric: tabular-nums; }
.record-bottom { display: flex; justify-content: space-between; align-items: center; }
.record-date { font-size: 22rpx; color: #999; }
.record-result { font-size: 24rpx; font-weight: bold; }
.record-arrow { font-size: 36rpx; color: #ccc; margin-left: 16rpx; }

.empty { text-align: center; color: #999; padding: 40rpx; }

/* 自定义操作菜单 */
.action-menu-mask { position: fixed; top: 0; left: 0; right: 0; bottom: 0; background: rgba(0,0,0,0.5); z-index: 100; }
.action-menu { position: fixed; left: 40rpx; right: 40rpx; bottom: 40rpx; background: white; border-radius: 24rpx; z-index: 101; overflow: hidden; }
.action-menu-title { text-align: center; padding: 30rpx; font-size: 28rpx; color: #999; border-bottom: 1rpx solid #f0f0f0; }
.action-menu-item { display: flex; align-items: center; justify-content: center; padding: 30rpx; font-size: 32rpx; color: #333; border-bottom: 1rpx solid #f0f0f0; }
.action-menu-item.delete { color: #ff4d4f; }
.action-menu-item:active { background: #f5f5f5; }
.menu-icon { margin-right: 16rpx; font-size: 36rpx; }
.action-menu-cancel { text-align: center; padding: 30rpx; font-size: 32rpx; color: #666; background: #f5f5f5; margin-top: 16rpx; border-radius: 0 0 24rpx 24rpx; }
.action-menu-cancel:active { background: #e8e8e8; }
