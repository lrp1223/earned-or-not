<!--pages/idiomGame/idiomGame.wxml-->
<view class="container">
  <view class="header">
    <text class="title">📚 成语接龙</text>
    <text class="subtitle">世界读书日特别版</text>
  </view>

  <!-- 准备界面 -->
  <view class="ready-screen" wx:if="{{gameState === 'ready'}}">
    <view class="intro">
      <text class="intro-icon">📖</text>
      <text class="intro-title">成语接龙挑战</text>
      <text class="intro-text">系统出成语，你接下一个</text>
      <text class="intro-text">首字接末字，10秒限时</text>
      <text class="intro-text">看你能接多少个！</text>
    </view>
    <button class="btn-start" bindtap="startGame">开始挑战</button>
    <view class="high-score" wx:if="{{highScore > 0}}">历史最高：{{highScore}}连击</view>
  </view>

  <!-- 游戏界面 -->
  <view class="game-screen" wx:if="{{gameState === 'playing'}}">
    <!-- 状态栏 -->
    <view class="status-bar">
      <view class="status-item">
        <text class="status-label">连击</text>
        <text class="status-value">{{combo}}</text>
      </view>
      <view class="status-item">
        <text class="status-label">称号</text>
        <text class="status-value title">{{title}}</text>
      </view>
      <view class="status-item">
        <text class="status-label">时间</text>
        <text class="status-value {{timeLeft <= 3 ? 'danger' : ''}}">{{timeLeft}}s</text>
      </view>
    </view>

    <!-- 当前成语 -->
    <view class="current-box">
      <text class="current-label">当前成语</text>
      <view class="current-idiom">
        <text wx:for="{{currentIdiom}}" wx:key="index" class="idiom-char">{{item}}</text>
      </view>
    </view>

    <!-- 目标字 -->
    <view class="target-box">
      <text class="target-label">请接以</text>
      <text class="target-char">"{{targetChar}}"</text>
      <text class="target-label">开头的成语</text>
    </view>

    <!-- 输入区 -->
    <view class="input-area">
      <input 
        class="idiom-input" 
        placeholder="输入4字成语..." 
        maxlength="4"
        value="{{inputValue}}"
        bindinput="onInput"
        confirm-type="done"
        bindconfirm="submitAnswer"
        focus="{{gameState === 'playing'}}"
      />
      <button class="btn-submit" bindtap="submitAnswer">提交</button>
    </view>

    <!-- 历史记录 -->
    <view class="history" wx:if="{{history.length > 1}}">
      <text class="history-label">已接龙 {{history.length}} 个</text>
      <view class="history-list">
        <text wx:for="{{history}}" wx:key="index" class="history-item">{{item}}</text>
      </view>
    </view>
  </view>

  <!-- 结束界面 -->
  <view class="over-screen" wx:if="{{gameState === 'over'}}">
    <text class="over-icon">{{result.icon}}</text>
    <text class="over-title">{{result.title}}</text>
    <text class="over-text">{{result.text}}</text>
    <view class="over-stats" wx:if="{{combo >= 5}}">
      <text class="stats-title">🏆 获得称号</text>
      <text class="stats-value">{{title}}</text>
    </view>
    <button class="btn-restart" bindtap="restart">{{result.btnText}}</button>
  </view>
</view>
