.container {
  min-height: 100vh;
  background: linear-gradient(180deg, #f6ffed 0%, #ffffff 100%);
  padding: 30rpx;
}
.header {
  text-align: center;
  padding: 30rpx 0;
}
.title {
  font-size: 48rpx;
  font-weight: bold;
  color: #52c41a;
  display: block;
}
.subtitle {
  font-size: 26rpx;
  color: #999;
  margin-top: 10rpx;
  display: block;
}

/* 准备界面 */
.ready-screen {
  text-align: center;
  padding: 60rpx 0;
}
.intro {
  background: white;
  border-radius: 24rpx;
  padding: 60rpx 40rpx;
  margin-bottom: 50rpx;
  box-shadow: 0 8rpx 32rpx rgba(0,0,0,0.06);
}
.intro-icon {
  font-size: 80rpx;
  display: block;
  margin-bottom: 20rpx;
}
.intro-title {
  font-size: 40rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 30rpx;
}
.intro-text {
  font-size: 28rpx;
  color: #666;
  display: block;
  margin: 16rpx 0;
}
.btn-start {
  width: 80%;
  height: 100rpx;
  line-height: 100rpx;
  background: linear-gradient(135deg, #52c41a 0%, #95de64 100%);
  color: white;
  font-size: 36rpx;
  font-weight: bold;
  border-radius: 50rpx;
  border: none;
  box-shadow: 0 12rpx 40rpx rgba(82, 196, 26, 0.4);
}
.high-score {
  margin-top: 40rpx;
  font-size: 28rpx;
  color: #999;
}

/* 游戏界面 */
.game-screen {
  padding: 20rpx 0;
}
.status-bar {
  display: flex;
  justify-content: space-around;
  background: white;
  border-radius: 16rpx;
  padding: 20rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.status-item {
  text-align: center;
}
.status-label {
  font-size: 22rpx;
  color: #999;
  display: block;
}
.status-value {
  font-size: 36rpx;
  font-weight: bold;
  color: #333;
  margin-top: 8rpx;
  display: block;
}
.status-value.title {
  font-size: 28rpx;
  color: #52c41a;
}
.status-value.danger {
  color: #ff4d4f;
  animation: blink 0.5s infinite;
}
@keyframes blink {
  0%, 100% { opacity: 1; }
  50% { opacity: 0.5; }
}

/* 当前成语 */
.current-box {
  background: white;
  border-radius: 20rpx;
  padding: 40rpx;
  text-align: center;
  margin-bottom: 30rpx;
  box-shadow: 0 4rpx 16rpx rgba(0,0,0,0.06);
}
.current-label {
  font-size: 26rpx;
  color: #999;
  display: block;
  margin-bottom: 20rpx;
}
.current-idiom {
  display: flex;
  justify-content: center;
  gap: 20rpx;
}
.idiom-char {
  width: 80rpx;
  height: 80rpx;
  line-height: 80rpx;
  background: linear-gradient(135deg, #52c41a 0%, #95de64 100%);
  border-radius: 16rpx;
  font-size: 40rpx;
  font-weight: bold;
  color: white;
}

/* 目标字 */
.target-box {
  text-align: center;
  margin: 40rpx 0;
}
.target-label {
  font-size: 28rpx;
  color: #666;
}
.target-char {
  font-size: 56rpx;
  font-weight: bold;
  color: #ff6b6b;
  margin: 0 16rpx;
}

/* 输入区 */
.input-area {
  display: flex;
  gap: 20rpx;
  margin: 40rpx 0;
}
.idiom-input {
  flex: 1;
  height: 100rpx;
  background: white;
  border-radius: 16rpx;
  padding: 0 30rpx;
  font-size: 36rpx;
  text-align: center;
  border: 2rpx solid #e8e8e8;
}
.btn-submit {
  width: 160rpx;
  height: 100rpx;
  line-height: 100rpx;
  background: linear-gradient(135deg, #ff6b6b 0%, #ff8e8e 100%);
  color: white;
  font-size: 32rpx;
  font-weight: bold;
  border-radius: 16rpx;
  border: none;
}

/* 历史记录 */
.history {
  margin-top: 40rpx;
}
.history-label {
  font-size: 26rpx;
  color: #999;
  margin-bottom: 16rpx;
  display: block;
}
.history-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}
.history-item {
  background: #f6ffed;
  padding: 12rpx 24rpx;
  border-radius: 8rpx;
  font-size: 26rpx;
  color: #52c41a;
}

/* 结束界面 */
.over-screen {
  text-align: center;
  padding: 60rpx 0;
}
.over-icon {
  font-size: 100rpx;
  display: block;
  margin-bottom: 30rpx;
}
.over-title {
  font-size: 48rpx;
  font-weight: bold;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
}
.over-text {
  font-size: 32rpx;
  color: #666;
  display: block;
  margin-bottom: 40rpx;
}
.over-stats {
  background: linear-gradient(135deg, #fff7e6 0%, #fffbe6 100%);
  border-radius: 20rpx;
  padding: 40rpx;
  margin: 40rpx 0;
}
.stats-title {
  font-size: 28rpx;
  color: #d48806;
  display: block;
  margin-bottom: 16rpx;
}
.stats-value {
  font-size: 40rpx;
  font-weight: bold;
  color: #fa8c16;
  display: block;
}
.btn-restart {
  width: 80%;
  height: 100rpx;
  line-height: 100rpx;
  background: linear-gradient(135deg, #52c41a 0%, #95de64 100%);
  color: white;
  font-size: 36rpx;
  font-weight: bold;
  border-radius: 50rpx;
  border: none;
  margin-top: 40rpx;
}
