// app.js 模板
// 复制为 app.js 后替换占位符即可使用

const api = require('./utils/api');

App({
  onLaunch() {
    const savedShareKey = wx.getStorageSync('shareKey');
    if (savedShareKey) {
      this.globalData.shareKey = savedShareKey;
      this.globalData.loginReady = Promise.resolve();
      return;
    }

    this.globalData.loginReady = new Promise((resolve, reject) => {
      wx.login({
        success: (loginRes) => {
          if (loginRes.code) {
            api.identify(loginRes.code).then(res => {
              this.globalData.shareKey = res.data.shareKey;
              wx.setStorageSync('shareKey', res.data.shareKey);
              console.log('身份建立成功');
              resolve();
            }).catch(err => {
              console.error('身份建立失败:', err);
              reject(err);
            });
          } else {
            reject('wx.login 未返回 code');
          }
        },
        fail: reject
      });
    });
  },
  globalData: { shareKey: null, loginReady: null }
});
